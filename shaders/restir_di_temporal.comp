#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_shading_language_packing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

#define RTV_STBN_TEXTURE_ENABLED 1
#define RTV_RESTIR_DI_ENABLE_RAY_QUERY 1
layout(set = 0, binding = 10) uniform accelerationStructureEXT topLevelAS;
#include "blue_noise.glsl"
#include "restir_di_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Input buffers
layout(set = 0, binding = 0, std430) readonly buffer InitialReservoirs {
    RestirDiReservoir initial_reservoirs[];
};
layout(set = 0, binding = 1, std430) readonly buffer PreviousReservoirs {
    RestirDiReservoir previous_reservoirs[];
};
layout(set = 0, binding = 2, std430) readonly buffer ReceiverBuffer {
    RestirDiReceiver receivers[];
};
layout(set = 0, binding = 3, std430) readonly buffer VelocityBuffer {
    uint velocity_buffer[];
};

// Output
layout(set = 0, binding = 4, std430) writeonly buffer TemporalReservoirs {
    RestirDiReservoir temporal_reservoirs[];
};

// Counter buffer
layout(set = 0, binding = 5, std430) buffer Counters {
    uint values[];
} counters;

layout(set = 0, binding = 6, std140) uniform Params {
    uint width;
    uint height;
    uint frameIndex;
    uint enabled;
    uint temporalMaxAge;
    uint spatialRounds;
    uint spatialMaxM;
    uint visibilityPolicy;
    float spatialRadius;
    float normalThreshold;
    float depthThreshold;
    float temporalLuminanceLimitFactor;
    float confidenceDecay;
    float lumClampNeighborAvgFactor;
    float lumClampNeighborMaxFactor;
    float fireflyClamp;
    float productionClampLuminance;
    uint mode;
    uint spatialResultValid;
    uint visibilityRayBudget;
    uint historyValid;
    uint materialVisibilityFlags;
    uint counterEnabled;
    uint rawOutputIsCurrentSample;
    uint padding2;
} params;

#define DI_COUNTER_ADD(counter, value) ((params.counterEnabled != 0u) ? atomicAdd(counter, value) : 0u)

layout(set = 0, binding = 7, std430) readonly buffer PreviousReceiverBuffer {
    RestirDiReceiver previous_receivers[];
};

// Velocity unpacking
vec2 unpack_velocity_pixels(uint packed) {
    ivec2 v = ivec2(packed & 0xffffu, (packed >> 16u) & 0xffffu);
    if (v.x >= 32768) v.x -= 65536;
    if (v.y >= 32768) v.y -= 65536;
    return vec2(v) * (512.0 / 32767.0);
}

RestirDiReservoir merge_zero_weight_history_m(
    RestirDiReservoir current,
    RestirDiReservoir previous) {
    uint rawM = restir_di_m(current) + restir_di_m(previous);
    uint cappedM = min(rawM, params.spatialMaxM);
    if (rawM > cappedM && rawM > 0u) {
        restir_di_set_weight_sum(current, restir_di_weight_sum(current) *
            float(cappedM) / float(rawM));
    }
    restir_di_set_m(current, cappedM);
    return current;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= int(params.width) || coords.y >= int(params.height)) {
        return;
    }

    uint pixelIndex = uint(coords.y) * params.width + uint(coords.x);
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_PIXELS], 1u);

    // Load current receiver
    RestirDiReceiver receiver = receivers[pixelIndex];

    // Check surface validity
    uint surfaceFlags = restir_di_receiver_surface_flags(receiver);
    if ((surfaceFlags & (RESTIR_DI_SURFACE_SKY | RESTIR_DI_SURFACE_INVALID |
                         RESTIR_DI_SURFACE_DELTA | RESTIR_DI_SURFACE_ALPHA |
                         RESTIR_DI_SURFACE_UNLIT | RESTIR_DI_SURFACE_UNSUPPORTED)) != 0u) {
        temporal_reservoirs[pixelIndex] = initial_reservoirs[pixelIndex];
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_SURFACE_REJECTED], 1u);
        return;
    }

    // Load initial reservoir
    RestirDiReservoir current = initial_reservoirs[pixelIndex];
    uint rejectionFlags = RESTIR_DI_REJECT_NONE;

    // Try temporal reuse
    if (params.enabled == 0u || params.historyValid == 0u) {
        temporal_reservoirs[pixelIndex] = current;
        return;
    }

    // Unpack velocity for reprojection
    uint packedVelocity = velocity_buffer[pixelIndex];
    vec2 velocityPixels = unpack_velocity_pixels(packedVelocity);
    ivec2 reprojectedCoords = coords - ivec2(int(round(velocityPixels.x)), int(round(velocityPixels.y)));

    bool reprojectValid = reprojectedCoords.x >= 0 && reprojectedCoords.y >= 0 &&
        reprojectedCoords.x < int(params.width) && reprojectedCoords.y < int(params.height);

    if (!reprojectValid || length(velocityPixels) > 48.0) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_REPROJECT_INVALID], 1u);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_REPROJECT_VALID], 1u);

    // Load previous reservoir
    uint prevIndex = uint(reprojectedCoords.y) * params.width + uint(reprojectedCoords.x);
    RestirDiReservoir previous = previous_reservoirs[prevIndex];

    // Load previous receiver for surface compatibility
    RestirDiReceiver prevReceiver = previous_receivers[prevIndex];

    // Surface compatibility
    if (!restir_di_surface_compatible(receiver, prevReceiver, params.normalThreshold, params.depthThreshold)) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_SURFACE_REJECTED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_SURFACE_MISMATCH;
        restir_di_set_rejection_flags(current, rejectionFlags);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }
    float receiverWorldDelta = length(receiver.worldPosition_depth.xyz - prevReceiver.worldPosition_depth.xyz);
    float receiverWorldLimit = max(0.05, max(abs(receiver.worldPosition_depth.w), 1.0) * params.depthThreshold);
    if (receiverWorldDelta > receiverWorldLimit) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_SURFACE_REJECTED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_SURFACE_MISMATCH;
        restir_di_set_rejection_flags(current, rejectionFlags);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }

    // An invalid reservoir can still represent zero-weight proposals. Merge
    // its M only after verifying that both receivers share a target domain.
    if (!restir_di_reservoir_valid(previous)) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_PREVIOUS_INVALID], 1u);
        temporal_reservoirs[pixelIndex] = merge_zero_weight_history_m(current, previous);
        return;
    }
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_PREVIOUS_VALID], 1u);

    if (restir_di_age(previous) >= params.temporalMaxAge) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_AGE_REJECTED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_AGE;
        restir_di_set_rejection_flags(current, rejectionFlags);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }

    RestirDiLightRecord previousLight;
    uint resolvedLightIndex;
    if (!restir_di_resolve_light(previous, previousLight, resolvedLightIndex)) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_LIGHT_VERSION_REJECTED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_LIGHT_VERSION;
        restir_di_set_rejection_flags(current, rejectionFlags);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }

    vec3 prevSampleDirection;
    float distToLight;
    vec3 lightNormal = restir_di_light_normal(previous);
    uint previousKind = restir_di_light_kind(previous);
    if (restir_di_light_kind_infinite(previousKind) && params.visibilityPolicy == 0u) {
        // Sun/environment are valid initial DI candidates, but production
        // temporal shifting needs a current-receiver transmittance model for
        // infinite lights before it is safe. Keep the current frame's all-light
        // sample and avoid feeding long-lived shifted sky/sun reservoirs into
        // the first-frame/final visibility path.
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_LIGHT_VERSION_REJECTED], 1u);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }
    if (previousKind == RESTIR_DI_LIGHT_AREA || previousKind == RESTIR_DI_LIGHT_SPOT) {
        lightNormal = normalize(vec3(previousLight.data1.w, previousLight.data2.w, previousLight.data3.x));
    }
    vec3 receiverNormal = normalize(receiver.normal_roughness.xyz);
    float sourcePdf = restir_di_pdf_at_receiver(
        resolvedLightIndex,
        previousLight,
        receiver.worldPosition_depth.xyz,
        previous.samplePosition_distance.xyz,
        lightNormal);
    vec3 reEvalRadiance = restir_di_evaluate_integrand(
        previous,
        receiver,
        previousLight,
        sourcePdf,
        prevSampleDirection,
        distToLight,
        lightNormal);

    // Target function at current receiver
    float targetAtCurrent = restir_di_target_function(reEvalRadiance);

    if (targetAtCurrent <= 1.0e-6) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_TARGET_REJECTED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_TARGET_ZERO;
        restir_di_set_rejection_flags(current, rejectionFlags);
        temporal_reservoirs[pixelIndex] = merge_zero_weight_history_m(current, previous);
        return;
    }

    // Source PDF check at current receiver
    if (sourcePdf <= 1.0e-6) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_PDF_REJECTED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_PDF_ZERO;
        restir_di_set_rejection_flags(current, rejectionFlags);
        temporal_reservoirs[pixelIndex] = merge_zero_weight_history_m(current, previous);
        return;
    }

    // Compute shifted weight
    float prevTarget = max(restir_di_target(previous), 1.0e-6);
    float prevWeightSum = restir_di_weight_sum(previous);
    float shiftedWeight = restir_di_shift_weight(targetAtCurrent, prevTarget, prevWeightSum);
    if (isnan(shiftedWeight) || isinf(shiftedWeight) || shiftedWeight < 0.0) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_NON_FINITE], 1u);
        temporal_reservoirs[pixelIndex] = current;
        return;
    }

    // Visibility policy
    uint prevVisibility = restir_di_visibility(previous);
    if (params.visibilityPolicy == 1u) {
        if (params.visibilityRayBudget == 0u) {
            rejectionFlags |= RESTIR_DI_REJECT_VISIBILITY;
            restir_di_set_rejection_flags(current, rejectionFlags);
            temporal_reservoirs[pixelIndex] = current;
            return;
        }
        // ReferenceValidation: trace actual shadow ray from current receiver to light
        vec3 lightPos = previous.samplePosition_distance.xyz;
        bool directionalSample = restir_di_light_kind(previous) == RESTIR_DI_LIGHT_DIRECTIONAL ||
            restir_di_light_kind_infinite(restir_di_light_kind(previous));
        vec3 toLight = directionalSample
            ? (restir_di_light_kind_infinite(restir_di_light_kind(previous))
                ? normalize(previous.samplePosition_distance.xyz)
                : normalize(previousLight.data1.xyz))
            : lightPos - receiver.worldPosition_depth.xyz;
        float dist = directionalSample ? previous.samplePosition_distance.w : length(toLight);
        if (dist > RESTIR_DI_VISIBILITY_EPSILON * 2.0) {
            vec3 shadowDir = directionalSample ? toLight : toLight / dist;
            float tmax = dist - RESTIR_DI_VISIBILITY_EPSILON * 2.0;
            vec3 shadowOrigin = receiver.worldPosition_depth.xyz +
                shadowDir * RESTIR_DI_VISIBILITY_EPSILON +
                receiverNormal * RESTIR_DI_VISIBILITY_EPSILON;
            prevVisibility = restir_di_ray_query_visible(
                shadowOrigin,
                shadowDir,
                tmax,
                params.materialVisibilityFlags);
            if (prevVisibility == RESTIR_DI_VISIBILITY_OCCLUDED) {
                DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_VISIBILITY_FAILED], 1u);
                rejectionFlags |= RESTIR_DI_REJECT_VISIBILITY;
                restir_di_set_rejection_flags(current, rejectionFlags);
                temporal_reservoirs[pixelIndex] = merge_zero_weight_history_m(current, previous);
                return;
            }
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_VISIBILITY_PASSED], 1u);
        } else {
            prevVisibility = RESTIR_DI_VISIBILITY_VISIBLE;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_VISIBILITY_SKIPPED], 1u);
        }
    } else {
        // Production: trust stored visibility or skip
        if (prevVisibility == RESTIR_DI_VISIBILITY_OCCLUDED) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_VISIBILITY_FAILED], 1u);
            rejectionFlags |= RESTIR_DI_REJECT_VISIBILITY;
            restir_di_set_rejection_flags(current, rejectionFlags);
            temporal_reservoirs[pixelIndex] = merge_zero_weight_history_m(current, previous);
            return;
        }
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_VISIBILITY_SKIPPED], 1u);
    }

    // Compute current reservoir weight
    float currentWeight = restir_di_weight_sum(current);
    float currentM = float(restir_di_m(current));

    // Reservoir update
    // Current and previous candidates compete via weighted reservoir sampling
    float rngValue = sample_dimension_1d(coords, params.frameIndex, 0u, 12u);

    // Motion confidence already attenuates both the previous sample mass and
    // its represented proposal count. Select from that same attenuated mass;
    // applying an additional probability cap without reweighting the selected
    // sample biases the reservoir and produces structured temporal artifacts.
    float motionMagnitude = length(velocityPixels);
    float motionConfidence = 1.0 - clamp(motionMagnitude / 24.0, 0.0, 0.85);
    float reuseConfidence = params.visibilityPolicy == 1u ? 1.0 : motionConfidence;
    float previousM_float = float(restir_di_m(previous));

    float previousMass = shiftedWeight * reuseConfidence;
    float currentMass = currentWeight;

    float totalMass = currentMass + previousMass;
    float previousProbability = 0.0;
    bool selectPrevious = false;

    if (totalMass > 1.0e-8) {
        previousProbability = clamp(previousMass / totalMass, 0.0, 1.0);
        selectPrevious = rngValue < previousProbability;
    }

    RestirDiReservoir selected = selectPrevious ? previous : current;

    // Update reservoir state
    if (selectPrevious) {
        // Shift the previous sample's metadata to current receiver
        restir_di_set_direction(selected, prevSampleDirection);
        selected.samplePosition_distance.w = distToLight;
        restir_di_set_target(selected, targetAtCurrent);
        selected.sampleMetadata.z = (resolvedLightIndex << 8u) | (previousKind & 0xffu);
        restir_di_set_source_pdf(selected, sourcePdf);
        restir_di_set_light_normal(selected, lightNormal);
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_ACCEPTED_PREVIOUS], 1u);
    } else {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_TEMPORAL_ACCEPTED_CURRENT], 1u);
    }

    // Age update
    restir_di_set_age(selected, selectPrevious ? min(restir_di_age(previous) + 1u, params.temporalMaxAge) : 0u);

    // M update. Reuse confidence can be fractional, but deterministically
    // ceil-ing that fractional proposal count turns smooth motion-confidence
    // gradients into visible M bands. Stochastic rounding preserves the
    // expected proposal count without a fixed spatial quantization contour.
    float combinedM = currentM + previousM_float * reuseConfidence;
    float cappedMFloat = clamp(combinedM, 1.0, float(params.spatialMaxM));
    float baseMFloat = floor(cappedMFloat);
    float mFraction = cappedMFloat - baseMFloat;
    float mRng = sample_dimension_1d(coords, params.frameIndex, 0u, 13u);
    uint roundedM = uint(baseMFloat) + (mRng < mFraction ? 1u : 0u);
    roundedM = clamp(roundedM, 1u, params.spatialMaxM);
    restir_di_set_m(selected, roundedM);

    // Weight sum update
    float combinedWeight = currentWeight + previousMass;
    if (combinedM > cappedMFloat && combinedM > 0.0) {
        combinedWeight *= cappedMFloat / combinedM;
    }
    restir_di_set_weight_sum(selected, combinedWeight);

    // A temporally reused sample has moved to the current receiver. In
    // production we do not trace during temporal resampling, so force the final
    // pass to validate the selected shifted sample before it can shade.
    uint selectedVisibility = restir_di_visibility(current);
    if (selectPrevious) {
        selectedVisibility = params.visibilityPolicy == 1u ||
            restir_di_light_kind_infinite(previousKind)
            ? prevVisibility
            : RESTIR_DI_VISIBILITY_UNKNOWN;
    }
    restir_di_set_visibility(selected, selectedVisibility);

    // Store previous weight for debug
    restir_di_set_previous_weight(selected, previousProbability);

    // Confidence: reduce under motion
    float confidence = selectPrevious ?
        clamp(restir_di_confidence(previous) * motionConfidence, 0.0, 1.0) :
        1.0;
    restir_di_set_confidence(selected, confidence);

    // Set valid
    restir_di_set_valid(selected, restir_di_reservoir_valid(selected));
    restir_di_set_rejection_flags(selected, rejectionFlags);

    temporal_reservoirs[pixelIndex] = selected;
}
