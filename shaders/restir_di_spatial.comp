#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_shading_language_packing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

#define RTV_STBN_TEXTURE_ENABLED 1
#define RTV_RESTIR_DI_ENABLE_RAY_QUERY 1
layout(set = 0, binding = 10) uniform accelerationStructureEXT topLevelAS;
#include "blue_noise.glsl"
#include "restir_di_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Input buffers
layout(set = 0, binding = 0, std430) readonly buffer TemporalReservoirs {
    RestirDiReservoir temporal_reservoirs[];
};
layout(set = 0, binding = 1, std430) readonly buffer ReceiverBuffer {
    RestirDiReceiver receivers[];
};

// Output
layout(set = 0, binding = 2, std430) writeonly buffer SpatialReservoirs {
    RestirDiReservoir spatial_reservoirs[];
};

// Counter buffer
layout(set = 0, binding = 3, std430) buffer Counters {
    uint values[];
} counters;

layout(set = 0, binding = 4, std140) uniform Params {
    uint width;
    uint height;
    uint frameIndex;
    uint enabled;
    uint temporalMaxAge;
    uint spatialRounds;
    uint spatialMaxM;
    uint visibilityPolicy;
    float spatialRadius;
    float normalThreshold;
    float depthThreshold;
    float temporalLuminanceLimitFactor;
    float confidenceDecay;
    float lumClampNeighborAvgFactor;
    float lumClampNeighborMaxFactor;
    float fireflyClamp;
    float productionClampLuminance;
    uint mode;
    uint spatialResultValid;
    uint visibilityRayBudget;
    uint historyValid;
    uint materialVisibilityFlags;
    uint counterEnabled;
    uint rawOutputIsCurrentSample;
    float shadowDistanceBias;
    uint lightVersion;
    uint environmentVersion;
} params;

layout(set = 0, binding = 24, std430) readonly buffer TemporalSourcePixels {
    uint temporal_source_pixels[];
};

layout(set = 0, binding = 25, std430) writeonly buffer SpatialSourcePixels {
    uint spatial_source_pixels[];
};

const uint RESTIR_DI_SOURCE_PIXEL_INVALID = 0xffffffffu;

uint restir_di_pack_source_pixel(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x > 65534 || p.y > 65534) {
        return RESTIR_DI_SOURCE_PIXEL_INVALID;
    }
    return uint(p.x) | (uint(p.y) << 16u);
}

uint restir_di_input_source_pixel(uint pixelIndex, ivec2 fallbackCoords) {
    uint fallback = restir_di_pack_source_pixel(fallbackCoords);
    if (params.temporalMaxAge == 0u) {
        return fallback;
    }
    uint source = temporal_source_pixels[pixelIndex];
    return source == RESTIR_DI_SOURCE_PIXEL_INVALID ? fallback : source;
}

#define DI_COUNTER_ADD(counter, value) ((params.counterEnabled != 0u) ? atomicAdd(counter, value) : 0u)

// Blue-noise neighbor offset
ivec2 blue_noise_offset(ivec2 coords, uint roundIndex) {
    vec2 sampleValue = sample_dimension_2d(coords, params.frameIndex, roundIndex, 8u);
    float angle = sampleValue.x * 2.0 * 3.14159265;
    float r = params.spatialRadius * sqrt(sampleValue.y);
    float ca = cos(angle);
    float sa = sin(angle);
    ivec2 offset = ivec2(int(floor(ca * r + 0.5)), int(floor(sa * r + 0.5)));
    if (all(equal(offset, ivec2(0)))) {
        uint h = sample_dimension_seed(coords, params.frameIndex, roundIndex, 10u);
        const ivec2 cardinal[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
        offset = cardinal[h & 3u];
    }
    return offset;
}

bool restir_di_spatial_reservoir_compatible(
    RestirDiReservoir center,
    RestirDiReservoir candidate,
    float shiftedPdf,
    float shiftedTarget) {
    if (!restir_di_reservoir_valid(candidate)) {
        return false;
    }
    if (!restir_di_reservoir_valid(center)) {
        return true;
    }
    if (restir_di_light_kind(center) != restir_di_light_kind(candidate)) {
        return false;
    }
    uint centerVisibility = restir_di_visibility(center);
    uint candidateVisibility = restir_di_visibility(candidate);
    if (centerVisibility == RESTIR_DI_VISIBILITY_INVALID ||
        candidateVisibility == RESTIR_DI_VISIBILITY_INVALID ||
        candidateVisibility == RESTIR_DI_VISIBILITY_OCCLUDED) {
        return false;
    }

    float centerPdf = restir_di_source_pdf(center);
    float pdfRatio = min(centerPdf, shiftedPdf) / max(centerPdf, shiftedPdf);
    float centerTarget = max(restir_di_target(center), 1.0e-5);
    float targetRatio = min(centerTarget, shiftedTarget) / max(centerTarget, shiftedTarget);
    return pdfRatio > 0.20 && targetRatio > 0.05;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= int(params.width) || coords.y >= int(params.height)) {
        return;
    }

    uint pixelIndex = uint(coords.y) * params.width + uint(coords.x);
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_PIXELS], 1u);

    // Load center receiver
    RestirDiReceiver centerReceiver = receivers[pixelIndex];

    // Check surface validity
    uint surfaceFlags = restir_di_receiver_surface_flags(centerReceiver);
    if ((surfaceFlags & (RESTIR_DI_SURFACE_SKY |
                         RESTIR_DI_SURFACE_INVALID |
                         RESTIR_DI_SURFACE_DELTA |
                         RESTIR_DI_SURFACE_ALPHA |
                         RESTIR_DI_SURFACE_UNLIT |
                         RESTIR_DI_SURFACE_UNSUPPORTED)) != 0u) {
        spatial_reservoirs[pixelIndex] = temporal_reservoirs[pixelIndex];
        spatial_source_pixels[pixelIndex] = restir_di_input_source_pixel(pixelIndex, coords);
        return;
    }

    // Load center temporal reservoir as starting point
    RestirDiReservoir merged = temporal_reservoirs[pixelIndex];
    uint mergedSourcePixel = restir_di_input_source_pixel(pixelIndex, coords);
    // Neighboring temporal reservoirs contain heavily overlapping histories.
    // Treat each input reservoir as one normalized representative estimate for
    // this spatial stage; importing every historical M again would count the
    // same temporal proposals repeatedly and bias W / M toward zero.
    float centerSourceM = float(restir_di_m(merged));
    if (centerSourceM > 0.0) {
        restir_di_set_weight_sum(
            merged,
            restir_di_weight_sum(merged) / centerSourceM);
        restir_di_set_m(merged, 1u);
    }
    float mergedMFloat = centerSourceM > 0.0 ? 1.0 : 0.0;
    uint rejectionFlags = restir_di_rejection_flags(merged);

    if (params.spatialResultValid == 0u || params.spatialRounds == 0u) {
        spatial_reservoirs[pixelIndex] = merged;
        spatial_source_pixels[pixelIndex] = mergedSourcePixel;
        return;
    }

    float neighborLuminanceSum = 0.0;
    float maxNeighborLum = 0.0;
    uint neighborCount = 0u;
    bool selectedNeighbor = false;
    uint localSpatialRounds = params.spatialRounds;
    uint currentSourcePixel = restir_di_pack_source_pixel(coords);
    bool sourceIsCurrent = mergedSourcePixel == currentSourcePixel ||
        mergedSourcePixel == RESTIR_DI_SOURCE_PIXEL_INVALID;
    bool unstableHistory = sourceIsCurrent ||
        (restir_di_confidence(merged) < 0.35 &&
         restir_di_previous_weight(merged) < 0.15);
    if (unstableHistory && localSpatialRounds < 8u) {
        localSpatialRounds = min(localSpatialRounds + 1u, 8u);
    }

    for (uint roundIndex = 0u; roundIndex < localSpatialRounds; ++roundIndex) {
        ivec2 sampleCoords = coords + blue_noise_offset(coords, roundIndex);
        if (sampleCoords.x < 0 || sampleCoords.y < 0 ||
            sampleCoords.x >= int(params.width) || sampleCoords.y >= int(params.height)) {
            continue;
        }

        uint sampleIndex = uint(sampleCoords.y) * params.width + uint(sampleCoords.x);
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_NEIGHBORS_TESTED], 1u);

        // Load neighbor reservoir
        RestirDiReservoir candidate = temporal_reservoirs[sampleIndex];

        // Surface compatibility is independent of whether this proposal found
        // a non-zero sample. Compatible zero-weight proposals still contribute
        // to M and therefore to the estimator normalization.
        RestirDiReceiver neighborReceiver = receivers[sampleIndex];
        if (!restir_di_surface_compatible(centerReceiver, neighborReceiver, params.normalThreshold, params.depthThreshold)) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_SURFACE_REJECTED], 1u);
            continue;
        }
        if (!restir_di_reservoir_valid(candidate)) {
            mergedMFloat += restir_di_m(candidate) > 0u ? 1.0 : 0.0;
            continue;
        }
        RestirDiLightRecord candidateLight;
        uint resolvedLightIndex;
        if (!restir_di_resolve_light(
                candidate,
                candidateLight,
                resolvedLightIndex,
                params.lightVersion,
                params.environmentVersion)) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_LIGHT_REJECTED], 1u);
            continue;
        }
        float candidateM = float(restir_di_m(candidate));
        if (candidateM <= 0.0) {
            rejectionFlags |= RESTIR_DI_REJECT_NAN;
            continue;
        }

        // Visibility gate
        if (params.visibilityPolicy == 1u &&
            restir_di_visibility(candidate) == RESTIR_DI_VISIBILITY_OCCLUDED) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_VISIBILITY_REJECTED], 1u);
            mergedMFloat += 1.0;
            continue;
        }

        // Re-evaluate candidate target at center receiver
        vec3 candidateDirection;
        vec3 candidatePosition = candidate.samplePosition_distance.xyz;
        vec3 centerPosition = centerReceiver.worldPosition_depth.xyz;
        float distToLight;
        uint candidateKind = restir_di_light_kind(candidate);
        vec3 candidateLightNormal = restir_di_light_normal(candidate);
        if (candidateKind == RESTIR_DI_LIGHT_AREA || candidateKind == RESTIR_DI_LIGHT_SPOT) {
            candidateLightNormal = normalize(vec3(candidateLight.data1.w, candidateLight.data2.w, candidateLight.data3.x));
        }
        float shiftedPdf = restir_di_pdf_at_receiver(
            resolvedLightIndex,
            candidateLight,
            centerPosition,
            candidatePosition,
            candidateLightNormal);
        vec3 candidateRadiance = restir_di_evaluate_integrand(
            candidate,
            centerReceiver,
            candidateLight,
            shiftedPdf,
            candidateDirection,
            distToLight,
            candidateLightNormal);

        vec3 centerNormal = normalize(centerReceiver.normal_roughness.xyz);

        float targetAtCenter = restir_di_target_function(candidateRadiance);
        if (!restir_di_spatial_reservoir_compatible(merged, candidate, shiftedPdf, targetAtCenter)) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_TARGET_REJECTED], 1u);
            mergedMFloat += 1.0;
            continue;
        }

        // Visibility check in ReferenceValidation mode
        bool visibilityChecked = false;
        float finiteLightDistanceBias = max(params.shadowDistanceBias, RESTIR_DI_VISIBILITY_EPSILON * 2.0);
        if (params.visibilityPolicy == 1u && roundIndex < params.visibilityRayBudget &&
            distToLight > finiteLightDistanceBias) {
            float tmax = distToLight - finiteLightDistanceBias;
            vec3 shadowOrigin = centerPosition +
                candidateDirection * RESTIR_DI_VISIBILITY_EPSILON +
                centerNormal * RESTIR_DI_VISIBILITY_EPSILON;
            uint visResult = restir_di_ray_query_visible(
                shadowOrigin,
                candidateDirection,
                tmax,
                params.materialVisibilityFlags);
            visibilityChecked = true;
            if (visResult == RESTIR_DI_VISIBILITY_OCCLUDED) {
                DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_VISIBILITY_REJECTED], 1u);
                mergedMFloat += 1.0;
                continue;
            }
        }

        if (targetAtCenter <= 1.0e-6) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_TARGET_REJECTED], 1u);
            mergedMFloat += 1.0;
            continue;
        }

        // Compute shifted weight
        float candidateTarget = max(restir_di_target(candidate), 1.0e-6);
        float candidateWeightSum = restir_di_weight_sum(candidate);
        float shiftedWeight = restir_di_shift_weight(
            targetAtCenter,
            candidateTarget,
            candidateWeightSum / candidateM);

        // Compatibility-weighted weight for reservoir update
        float candidateWeight = shiftedWeight;
        if (!(candidateWeight > 0.0) || isnan(candidateWeight) || isinf(candidateWeight)) {
            rejectionFlags |= RESTIR_DI_REJECT_NAN;
            continue;
        }

        // Stochastic selection
        float rngValue = sample_dimension_1d(coords, params.frameIndex, roundIndex, 15u);

        float reservoirWeightBefore = restir_di_weight_sum(merged);
        float selectionProbability = candidateWeight / max(reservoirWeightBefore + candidateWeight, 1.0e-8);
        RestirDiReservoir shiftedCandidate = candidate;
        restir_di_set_direction(shiftedCandidate, candidateDirection);
        shiftedCandidate.samplePosition_distance.w = distToLight;
        restir_di_set_target(shiftedCandidate, targetAtCenter);
        shiftedCandidate.sampleMetadata.z = (resolvedLightIndex << 8u) | (candidateKind & 0xffu);
        if (shiftedPdf <= 1.0e-6) {
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_TARGET_REJECTED], 1u);
            mergedMFloat += 1.0;
            continue;
        }
        restir_di_set_source_pdf(shiftedCandidate, shiftedPdf);
        restir_di_set_light_normal(shiftedCandidate, candidateLightNormal);
        uint shiftedVisibility = visibilityChecked
            ? RESTIR_DI_VISIBILITY_VISIBLE
            : RESTIR_DI_VISIBILITY_UNKNOWN;
        if (!visibilityChecked && params.visibilityPolicy == 0u &&
            restir_di_light_kind_infinite(candidateKind)) {
            shiftedVisibility = restir_di_visibility(candidate) == RESTIR_DI_VISIBILITY_OCCLUDED
                ? RESTIR_DI_VISIBILITY_OCCLUDED
                : RESTIR_DI_VISIBILITY_VISIBLE;
        }
        restir_di_set_visibility(shiftedCandidate, shiftedVisibility);

        if (!restir_di_reservoir_update(merged, shiftedCandidate, candidateWeight, 1.0, rngValue, rejectionFlags)) {
            continue;
        }
        mergedMFloat += 1.0;
        if (rngValue < selectionProbability) {
            selectedNeighbor = true;
            mergedSourcePixel = restir_di_input_source_pixel(sampleIndex, sampleCoords);
        }

        neighborLuminanceSum += targetAtCenter;
        maxNeighborLum = max(maxNeighborLum, targetAtCenter);
        neighborCount += 1u;
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_NEIGHBORS_ACCEPTED], 1u);

    }

    float cappedMergedM = min(mergedMFloat, float(max(params.spatialMaxM, 1u)));
    if (mergedMFloat > cappedMergedM) {
        float massScale = cappedMergedM / max(mergedMFloat, 1.0);
        restir_di_set_weight_sum(merged, restir_di_weight_sum(merged) * massScale);
    }
    restir_di_set_m(merged, uint(clamp(ceil(cappedMergedM), 0.0, 255.0)));

    // Production stabilization: clamp against neighbors
    if (params.temporalLuminanceLimitFactor > 0.0 &&
        neighborCount > 0u && restir_di_reservoir_valid(merged)) {
        float neighborAvgLum = neighborLuminanceSum / float(neighborCount);
        float mergedLum = restir_di_target(merged);
        float lumCap = max(max(neighborAvgLum * params.lumClampNeighborAvgFactor,
                               maxNeighborLum * params.lumClampNeighborMaxFactor), 0.05);
        if (mergedLum > lumCap && mergedLum > 1.0e-6) {
            float capScale = lumCap / mergedLum;
            restir_di_set_weight_sum(merged, restir_di_weight_sum(merged) * capScale);
            rejectionFlags |= RESTIR_DI_REJECT_CLAMPED;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_CLAMPED], 1u);
        }

        // Confidence decay
        restir_di_set_confidence(merged, restir_di_confidence(merged) * params.confidenceDecay);
    }

    // Set rejection flags
    restir_di_set_rejection_flags(merged, rejectionFlags);

    // Preserve validity
    restir_di_set_valid(merged, restir_di_reservoir_valid(merged));

    spatial_reservoirs[pixelIndex] = merged;
    spatial_source_pixels[pixelIndex] = mergedSourcePixel;
    if (neighborCount > 0u) {
        DI_COUNTER_ADD(counters.values[selectedNeighbor
            ? RESTIR_DI_COUNTER_SPATIAL_SELECTED_NEIGHBOR
            : RESTIR_DI_COUNTER_SPATIAL_SELECTED_CENTER], 1u);
    }
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_SPATIAL_ROUNDS], localSpatialRounds);
}
