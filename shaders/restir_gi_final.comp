#version 450
#extension GL_GOOGLE_include_directive : require

#include "restir_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D raw_image;
layout(set = 0, binding = 1, std430) readonly buffer CurrentGiReservoirs { RestirGiReservoir current_gi_reservoirs[]; };
layout(set = 0, binding = 3, std430) readonly buffer SpatialGiReservoirs { RestirGiReservoir spatial_gi_reservoirs[]; };
layout(set = 0, binding = 7, std430) buffer AccumulationBuffer { vec4 accumulation_buffer[]; };
layout(set = 0, binding = 8, std430) readonly buffer VelocityBuffer { uint velocity_buffer[]; };

struct PathDataRecord {
    vec4 direct_diffuse;
    vec4 direct_specular;
    vec4 indirect_diffuse;
    vec4 indirect_specular;
    vec4 albedo_roughness_hit_confidence;
    vec4 material_specular_albedo;
    vec4 denoiser_hit_distance;
    vec4 diffuse_ray_direction_hit_distance;
    vec4 specular_ray_direction_hit_distance;
    vec4 emissive_residual;
};

layout(set = 0, binding = 6, std430) buffer PathDataBuffer { PathDataRecord path_data_buffer[]; };

const float SCREEN_VELOCITY_PACK_SCALE = 512.0;

vec2 restir_unpack_velocity_pixels(uint packedVelocity) {
    int x = int(packedVelocity & 0xffffu);
    int y = int((packedVelocity >> 16u) & 0xffffu);
    if (x >= 32768) {
        x -= 65536;
    }
    if (y >= 32768) {
        y -= 65536;
    }
    return vec2(float(x), float(y)) * (SCREEN_VELOCITY_PACK_SCALE / 32767.0);
}

layout(set = 0, binding = 4, std140) uniform RendererDebug {
    uint view;
    uint flags;
    uint selected_instance;
    float scale;
} debug_params;

layout(set = 0, binding = 5, std140) uniform RestirGiFinalParams {
    uint width;
    uint height;
    uint frame_count;
    uint enabled;
    uint gi_spatial_rounds;
    uint gi_half_resolution;
    uint gi_temporal_max_age;
    uint gi_visibility_ray_budget;
    float gi_spatial_radius;
    float gi_depth_threshold_scale;
    float gi_spatial_compatibility_threshold;
    float raw_output_is_current_sample;
    vec4 camera_position;
} params;

vec3 reservoir_radiance(RestirGiReservoir reservoir) {
    return restir_gi_reservoir_valid(reservoir) ? max(reservoir.radiance_weight_sum.rgb, vec3(0.0)) : vec3(0.0);
}

float luminance(vec3 value) {
    return dot(value, vec3(0.2126, 0.7152, 0.0722));
}

float reservoir_confidence(RestirGiReservoir reservoir) {
    if (!restir_gi_reservoir_valid(reservoir)) {
        return 0.0;
    }
    float sampleConfidence = clamp(restir_gi_sample_count(reservoir) / 16.0, 0.0, 1.0);
    float ageConfidence = 1.0 - restir_gi_age_normalized(reservoir, 32.0);
    return sampleConfidence * ageConfidence * (restir_gi_visible(reservoir) ? 1.0 : 0.0);
}

vec3 clamp_luminance_preserve_hue(vec3 value, float maxLum) {
    value = max(value, vec3(0.0));
    float valueLum = luminance(value);
    if (valueLum <= maxLum || valueLum <= 1.0e-6) {
        return value;
    }
    return value * (maxLum / valueLum);
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= int(params.width) || coords.y >= int(params.height)) {
        return;
    }

    uint pixelIndex = uint(coords.y) * params.width + uint(coords.x);
    RestirGiReservoir currentReservoir = current_gi_reservoirs[pixelIndex];
    RestirGiReservoir spatialReservoir = spatial_gi_reservoirs[pixelIndex];

    vec3 currentGi = reservoir_radiance(currentReservoir);
    vec3 spatialGi = reservoir_radiance(spatialReservoir);
    float debugScale = max(debug_params.scale, 1.0);

    if (debug_params.view == 72u) {
        imageStore(raw_image, coords, vec4(spatialGi * debugScale * 16.0, 1.0));
        return;
    }

    bool beautyView = debug_params.view == 0u;
    bool finalDebugView = debug_params.view == 73u;
    if (!beautyView && !finalDebugView) {
        return;
    }
    if (params.enabled == 0u && !finalDebugView) {
        return;
    }

    vec3 base = max(imageLoad(raw_image, coords).rgb, vec3(0.0));
    vec4 accumulated = accumulation_buffer[pixelIndex];
    float accumulationSamples = max(accumulated.a, 1.0);
    RestirGiReservoir confidenceReservoir = restir_gi_reservoir_valid(spatialReservoir)
        ? spatialReservoir
        : currentReservoir;
    vec3 targetGi = restir_gi_reservoir_valid(spatialReservoir)
        ? spatialGi
        : currentGi;
    float giConfidence = reservoir_confidence(confidenceReservoir);
    float baseLum = luminance(base);
    float currentLum = luminance(currentGi);
    float targetLum = luminance(targetGi);
    bool finalStabilizationEnabled = (params.enabled & 2u) != 0u;
    float replacementStrength = 1.0;
    vec3 replacementGi = targetGi;
    if (finalStabilizationEnabled) {
        float radianceAgreement = sqrt((min(currentLum, targetLum) + 0.01) / (max(currentLum, targetLum) + 0.01));
        float darkStability = smoothstep(0.035, 0.35, baseLum);
        float historyStability = smoothstep(2.0, 12.0, accumulationSamples);
        float motionPixels = length(restir_unpack_velocity_pixels(velocity_buffer[pixelIndex]));
        float motionStability = 1.0 - smoothstep(1.0, 18.0, motionPixels);
        replacementStrength = clamp(
            giConfidence *
            mix(0.10, 0.65, darkStability) *
            mix(0.35, 1.0, historyStability) *
            mix(0.25, 1.0, motionStability) *
            mix(0.40, 1.0, radianceAgreement),
            0.0,
            0.65);
        replacementGi = mix(currentGi, targetGi, replacementStrength);
        float replacementLumLimit = max(
            0.006,
            currentLum * mix(1.15, 2.50, darkStability) +
            baseLum * mix(0.10, 0.35, darkStability) +
            mix(0.006, 0.025, darkStability));
        replacementGi = clamp_luminance_preserve_hue(replacementGi, replacementLumLimit);
    }
    vec3 giDelta = replacementGi - currentGi;
    accumulation_buffer[pixelIndex] = vec4(max(accumulated.rgb + giDelta, vec3(0.0)), accumulated.a);
    float rawDeltaScale = params.raw_output_is_current_sample > 0.5 ? 1.0 : (1.0 / accumulationSamples);
    vec3 replaced = max(base + giDelta * rawDeltaScale, vec3(0.0));
    imageStore(raw_image, coords, vec4(replaced, 1.0));

    PathDataRecord path = path_data_buffer[pixelIndex];
    path.indirect_diffuse.rgb = max(path.indirect_diffuse.rgb + giDelta, vec3(0.0));
    float guideStrength = giConfidence * replacementStrength;
    path.indirect_diffuse.a = max(path.indirect_diffuse.a, guideStrength);
    if (restir_gi_reservoir_valid(confidenceReservoir)) {
        float giHitDistance = clamp(restir_gi_hit_distance(confidenceReservoir), 0.0, 65504.0);
        if (guideStrength > 0.04 && giHitDistance > 0.001 && giHitDistance < 65504.0) {
            float guideBlend = clamp(guideStrength, 0.0, 0.75);
            float previousDiffuseHitDistance = path.denoiser_hit_distance.x > 0.001 && path.denoiser_hit_distance.x < 65504.0
                ? path.denoiser_hit_distance.x
                : giHitDistance;
            path.denoiser_hit_distance.x = mix(previousDiffuseHitDistance, giHitDistance, guideBlend);
            path.diffuse_ray_direction_hit_distance.w = path.denoiser_hit_distance.x;
#if RTV_RESTIR_GI_UNCOMPRESSED_LAYOUT
            vec3 giDirection = confidenceReservoir.hit_position_target_pdf.xyz - confidenceReservoir.receiver_position_hit_distance.xyz;
            if (dot(giDirection, giDirection) > 1.0e-8) {
                vec3 previousDiffuseDirection = dot(path.diffuse_ray_direction_hit_distance.xyz, path.diffuse_ray_direction_hit_distance.xyz) > 1.0e-8
                    ? normalize(path.diffuse_ray_direction_hit_distance.xyz)
                    : normalize(giDirection);
                path.diffuse_ray_direction_hit_distance.xyz = normalize(mix(previousDiffuseDirection, normalize(giDirection), guideBlend));
            }
#endif
        }
    }
    path_data_buffer[pixelIndex] = path;
}
