// ReSTIR GI Final Shading (LegacyCache)
// Self-contained: no rt_common.glsl dependency.

#version 460
#extension GL_GOOGLE_include_directive : require

#include "path_data_common.glsl"
#include "restir_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D raw_image;
layout(set = 0, binding = 1, std430) readonly buffer CurrentGiReservoirs { RestirGiReservoir current_gi_reservoirs[]; };
layout(set = 0, binding = 3, std430) readonly buffer SpatialGiReservoirs { RestirGiReservoir spatial_gi_reservoirs[]; };
layout(set = 0, binding = 7, std430) buffer AccumulationBuffer { vec4 accumulation_buffer[]; };
layout(set = 0, binding = 8, std430) readonly buffer VelocityBuffer { uint velocity_buffer[]; };
layout(set = 0, binding = 6, std430) buffer PathDataBuffer { PathDataRecord path_data_buffer[]; };

layout(set = 0, binding = 5, std140) uniform RestirGiSpatialParams {
    uint width;
    uint height;
    uint frame_count;
    uint enabled;
    uint gi_spatial_rounds;
    uint gi_half_resolution;
    uint gi_temporal_max_age;
    uint gi_visibility_ray_budget;
    float gi_spatial_radius;
    float gi_depth_threshold_scale;
    float gi_spatial_compatibility_threshold;
    float raw_output_is_current_sample;
    vec4 camera_position;
} params;

layout(set = 0, binding = 4, std140) uniform DebugParams {
    uint view;
    uint flags;
    uint selected_instance;
    float scale;
} debug_params;

vec3 scalar_contract_color(float value, float range) {
    if (isnan(value) || isinf(value) || value < 0.0) {
        return vec3(1.0, 0.0, 0.8);
    }
    float normalizedValue = clamp(log2(max(value, 0.0) + 1.0) / max(range, 1.0e-6), 0.0, 1.0);
    return vec3(normalizedValue, sqrt(normalizedValue), 1.0 - normalizedValue);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(params.width) || pixel.y >= int(params.height)) return;
    uint pixelIndex = pixel.y * params.width + pixel.x;

    RestirGiReservoir currentRes = current_gi_reservoirs[pixelIndex];
    RestirGiReservoir spatialRes = spatial_gi_reservoirs[pixelIndex];
    RestirGiReservoir selectedRes = restir_gi_reservoir_valid(spatialRes) ? spatialRes : currentRes;

    vec3 currentGi = restir_gi_reservoir_valid(currentRes) ? max(currentRes.radiance_weight_sum.rgb, vec3(0.0)) : vec3(0.0);
    vec3 spatialGi = restir_gi_reservoir_valid(spatialRes) ? max(spatialRes.radiance_weight_sum.rgb, vec3(0.0)) : vec3(0.0);
    float debugScale = max(debug_params.scale, 1.0);

    if (debug_params.view == 72u) {
        imageStore(raw_image, pixel, vec4(spatialGi * debugScale * 16.0, 1.0));
        return;
    }
    if (debug_params.view == 127u) {
        vec3 targetGi = restir_gi_reservoir_valid(spatialRes) ? spatialGi : currentGi;
        float l = clamp(restir_luminance(max(targetGi, vec3(0.0))) * debugScale * 16.0, 0.0, 1.0);
        vec3 tint = ((pixel.x ^ pixel.y) & 1) == 0
            ? vec3(0.2, 0.55, 1.0)
            : vec3(1.0, 0.45, 0.15);
        imageStore(raw_image, pixel, vec4(tint * l, 1.0));
        return;
    }
    if (debug_params.view == 128u) {
        if (!restir_gi_reservoir_valid(selectedRes)) {
            imageStore(raw_image, pixel, vec4(0.3, 0.0, 0.05, 1.0));
            return;
        }
        float roughness = restir_gi_roughness(selectedRes);
        vec3 tint = roughness >= 0.35 ? vec3(0.1, 0.9, 0.35) : vec3(1.0, 0.55, 0.08);
        imageStore(raw_image, pixel, vec4(tint, 1.0));
        return;
    }
    if (debug_params.view == 152u) {
        imageStore(raw_image, pixel, vec4(scalar_contract_color(restir_gi_target_function(selectedRes), 16.0), 1.0));
        return;
    }
    if (debug_params.view == 153u) {
        imageStore(raw_image, pixel, vec4(scalar_contract_color(restir_gi_target_pdf(selectedRes), 16.0), 1.0));
        return;
    }
    if (debug_params.view == 154u) {
        imageStore(raw_image, pixel, vec4(scalar_contract_color(selectedRes.radiance_weight_sum.w, 16.0), 1.0));
        return;
    }
    if (debug_params.view == 155u) {
        imageStore(raw_image, pixel, vec4(vec3(clamp(restir_gi_sample_count(selectedRes) / 255.0, 0.0, 1.0)), 1.0));
        return;
    }
    if (debug_params.view == 156u) {
        float sampleFactor = restir_gi_reservoir_valid(selectedRes)
            ? clamp(restir_gi_sample_count(selectedRes) / 16.0, 0.0, 1.0)
            : 0.0;
        float ageFactor = 1.0 - clamp(float(restir_gi_age(selectedRes)) / 32.0, 0.0, 0.75);
        float visFactor = restir_gi_visible(selectedRes) ? 1.0 : 0.25;
        imageStore(raw_image, pixel, vec4(vec3(sampleFactor * ageFactor * visFactor), 1.0));
        return;
    }
    if (debug_params.view == 157u) {
        bool valid = restir_gi_reservoir_valid(selectedRes);
        imageStore(raw_image, pixel, vec4(0.35, restir_gi_visible(selectedRes) ? 1.0 : 0.0, valid ? 0.0 : 1.0, 1.0));
        return;
    }

    bool beautyView = debug_params.view == 0u;
    bool finalDebugView = debug_params.view == 73u;
    if (!beautyView && !finalDebugView) {
        return;
    }
    if ((params.enabled & 1u) == 0u && !finalDebugView) {
        return;
    }

    float giConfidence = 0.0;
    {
        if (restir_gi_reservoir_valid(selectedRes)) {
            float sampleFactor = clamp(restir_gi_sample_count(selectedRes) / 16.0, 0.0, 1.0);
            float ageFactor = 1.0 - clamp(float(restir_gi_age(selectedRes)) / 32.0, 0.0, 0.75);
            float visFactor = restir_gi_visible(selectedRes) ? 1.0 : 0.25;
            giConfidence = sampleFactor * ageFactor * visFactor;
        }
    }

    vec4 rawBase = imageLoad(raw_image, pixel);
    vec4 accumulated = accumulation_buffer[pixelIndex];
    float accumSamples = max(accumulated.a, 1.0);

    bool finalStabilizationEnabled = (params.enabled & 2u) != 0u;
    vec3 targetGi = restir_gi_reservoir_valid(spatialRes) ? spatialGi : currentGi;
    vec3 replacementGi = targetGi;
    float replacementStrength = 1.0;

    if (finalStabilizationEnabled) {
        float baseLum = max(restir_luminance(rawBase.rgb), 1.0e-6);
        float giLum = max(restir_luminance(targetGi), 1.0e-6);
        float rawLum = max(restir_luminance(rawBase.rgb + targetGi), 1.0e-6);
        float ratio = min(baseLum, giLum) / max(rawLum, 1.0e-6);
        float agreementFactor = sqrt(clamp(ratio, 0.0, 1.0));
        float historyFactor = 1.0 - exp(-accumSamples / 16.0);
        uint packedVel = velocity_buffer[pixelIndex];
        int encodedX = int(packedVel & 0xffffu);
        int encodedY = int((packedVel >> 16u) & 0xffffu);
        if (encodedX >= 32768) encodedX -= 65536;
        if (encodedY >= 32768) encodedY -= 65536;
        float motionMag = length(vec2(encodedX, encodedY) * (512.0 / 32767.0));
        float motionFactor = 1.0 - smoothstep(0.0, 4.0, motionMag);
        replacementStrength = agreementFactor * historyFactor * motionFactor * giConfidence;
        replacementStrength = clamp(replacementStrength, 0.0, 0.65);
        replacementGi = mix(currentGi, targetGi, replacementStrength);
    }

    float currentLum = restir_luminance(replacementGi);
    float baseLum = restir_luminance(rawBase.rgb);
    float maxGiLum = baseLum * 4.0 + 0.5;
    if (currentLum > maxGiLum) replacementGi *= maxGiLum / currentLum;

    vec3 giDelta = replacementGi - currentGi;
    accumulated.rgb = max(accumulated.rgb + giDelta, vec3(0.0));
    accumulation_buffer[pixelIndex] = accumulated;

    float rawDeltaScale = params.raw_output_is_current_sample > 0.5 ? 1.0 : 1.0 / max(accumulated.a, 1.0);
    imageStore(raw_image, pixel, vec4(max(rawBase.rgb + giDelta * rawDeltaScale, vec3(0.0)), 1.0));

    vec4 indirectDiffuse = path_data_buffer[pixelIndex].indirect_diffuse;
    indirectDiffuse.rgb = max(indirectDiffuse.rgb + giDelta, vec3(0.0));
    float guideStrength = giConfidence * replacementStrength;
    indirectDiffuse.a = max(indirectDiffuse.a, guideStrength);
    path_data_buffer[pixelIndex].indirect_diffuse = indirectDiffuse;
    if (restir_gi_reservoir_valid(selectedRes)) {
        float giHitDistance = clamp(restir_gi_hit_distance(selectedRes), 0.0, 65504.0);
        if (guideStrength > 0.04 && giHitDistance > 0.001 && giHitDistance < 65504.0) {
            float guideBlend = clamp(guideStrength, 0.0, 0.75);
            float currentDiffuseHitDistance = path_data_buffer[pixelIndex].denoiser_hit_distance.x;
            float previousDiffuseHitDistance =
                currentDiffuseHitDistance > 0.001 && currentDiffuseHitDistance < 65504.0
                    ? currentDiffuseHitDistance
                    : giHitDistance;
            float resolvedHitDistance = mix(previousDiffuseHitDistance, giHitDistance, guideBlend);
            path_data_buffer[pixelIndex].denoiser_hit_distance.x = resolvedHitDistance;
            path_data_buffer[pixelIndex].diffuse_ray_direction_hit_distance.w = resolvedHitDistance;
        }
    }
}
