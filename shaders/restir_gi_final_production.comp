#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

#define RTV_RESTIR_DI_ENABLE_RAY_QUERY 1
layout(set = 0, binding = 33) uniform accelerationStructureEXT topLevelAS;
#include "restir_di_common.glsl"
#include "path_data_common.glsl"
#include "restir_gi_common.glsl"
#include "restir_gi_prod_packing.glsl"
#include "restir_gi_reconnection.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba16f) uniform image2D rawImage;
layout(set = 0, binding = 1, std430) readonly buffer CurrentReservoirs { ProdRestirGiReservoir current_reservoirs[]; };
layout(set = 0, binding = 2, std430) readonly buffer SpatialReservoirs { ProdRestirGiReservoir spatial_reservoirs[]; };
layout(set = 0, binding = 3, std430) readonly buffer ReceiverBuffer { RestirGiReceiver receivers[]; };
layout(set = 0, binding = 4, std430) buffer AccumulationBuffer { vec4 accumulation_buffer[]; };
layout(set = 0, binding = 5, std430) buffer PathDataBuffer { PathDataRecord path_data_buffer[]; };
layout(set = 0, binding = 6, std430) readonly buffer VelocityBuffer { uint velocity_buffer[]; };
layout(set = 0, binding = 7, std430) buffer RestirGiCounterBuffer { uint restir_gi_counters[]; };
layout(set = 0, binding = 8, std430) readonly buffer ActiveTileMask { uint active_tile_mask[]; };
const uint GI_COUNTER_FINAL_PIXELS = 17u;
const uint GI_COUNTER_FINAL_SPATIAL_USED = 18u;
const uint GI_COUNTER_FINAL_CURRENT_USED = 19u;
const uint GI_COUNTER_FINAL_FALLBACK = 20u;
const uint GI_COUNTER_FINAL_CLAMP = 21u;
const uint GI_COUNTER_FINAL_STABILIZED = 25u;
const uint GI_COUNTER_GRID_LUMA_X_EVEN = 28u;
const uint GI_COUNTER_GRID_LUMA_X_ODD = 29u;
const uint GI_COUNTER_GRID_LUMA_Y_EVEN = 30u;
const uint GI_COUNTER_GRID_LUMA_Y_ODD = 31u;
const uint GI_COUNTER_PATH_FINAL_DIFFUSE_REUSABLE = 38u;
const uint GI_COUNTER_PATH_FINAL_GLOSSY_REUSABLE = 39u;
const uint GI_COUNTER_PATH_FINAL_OTHER = 40u;
const uint GI_COUNTER_PATH_FINAL_INVALID = 41u;
const uint GI_COUNTER_VISIBILITY_RAYS = 42u;
const uint GI_COUNTER_VISIBILITY_UNKNOWN = 43u;
const uint GI_COUNTER_VERSION_REJECT = 44u;
const uint GI_COUNTER_NON_FINITE = 45u;

const uint DEBUG_VIEW_RESTIR_GI_VALIDITY = 68u;
const uint DEBUG_VIEW_RESTIR_GI_AGE = 69u;
const uint DEBUG_VIEW_RESTIR_GI_INITIAL = 70u;
const uint DEBUG_VIEW_RESTIR_GI_TEMPORAL = 71u;
const uint DEBUG_VIEW_RESTIR_GI_SPATIAL = 72u;
const uint DEBUG_VIEW_RESTIR_GI_FINAL = 73u;
const uint DEBUG_VIEW_RESTIR_GI_NORMAL = 90u;
const uint DEBUG_VIEW_RESTIR_GI_HIT_DISTANCE = 91u;
const uint DEBUG_VIEW_RESTIR_GI_GRID = 127u;
const uint DEBUG_VIEW_RESTIR_GI_PATH_CLASS = 128u;

layout(push_constant, std430) uniform PushConstants {
    uint width;
    uint height;
    uint frameIndex;
    uint enabled;
    uint debugView;
    float fireflyClamp;
    float indirectStrength;
    float rawOutputIsCurrentSample;
    uint halfResolution;
    uint visibilityRayBudget;
    uint referenceValidation;
    float minFinalBlendStrength;
    vec4 cameraPosition;
} pc;

#define GI_COUNTER_ADD(counter, value) (((pc.enabled & 4u) != 0u) ? atomicAdd(counter, value) : 0u)
#define GI_ACTIVE_TILE_MASK_ENABLED ((pc.enabled & 8u) != 0u)

const uint GI_ACTIVE_TILE_SIZE = 16u;

bool active_tile_contains(ivec2 pixel) {
    if (!GI_ACTIVE_TILE_MASK_ENABLED) return true;
    uint tileColumns = (pc.width + GI_ACTIVE_TILE_SIZE - 1u) / GI_ACTIVE_TILE_SIZE;
    uint tileIndex = uint(pixel.y) / GI_ACTIVE_TILE_SIZE * tileColumns +
        uint(pixel.x) / GI_ACTIVE_TILE_SIZE;
    return active_tile_mask[tileIndex] != 0u;
}

vec2 unpack_velocity_pixels(uint packed) {
    ivec2 e = ivec2(packed & 0xffffu, (packed >> 16u) & 0xffffu);
    if (e.x >= 32768) e.x -= 65536;
    if (e.y >= 32768) e.y -= 65536;
    return vec2(e) * (512.0 / 32767.0);
}

bool is_gi_debug(uint view) {
    return (view >= DEBUG_VIEW_RESTIR_GI_VALIDITY && view <= DEBUG_VIEW_RESTIR_GI_FINAL) ||
        view == DEBUG_VIEW_RESTIR_GI_NORMAL || view == DEBUG_VIEW_RESTIR_GI_HIT_DISTANCE ||
        view == DEBUG_VIEW_RESTIR_GI_GRID || view == DEBUG_VIEW_RESTIR_GI_PATH_CLASS;
}

bool trace_visibility(RestirGiReceiver receiver, ProdRestirGiReservoir reservoir) {
    bool environment = prod_unpack_path_class(reservoir) == PROD_PATH_CLASS_ENVIRONMENT_REUSABLE;
    vec3 origin = restir_gi_receiver_position(receiver);
    vec3 direction;
    float tMax;
    if (environment) {
        direction = normalize(reservoir.x2PositionDistance.xyz);
        tMax = 10000.0;
    } else {
        vec3 delta = reservoir.x2PositionDistance.xyz - origin;
        tMax = length(delta);
        if (tMax <= 1.0e-3) return false;
        direction = delta / tMax;
    }
    float bias = max(1.0e-4, 1.0e-4 * min(tMax, 100.0));
    uint visibility = restir_di_ray_query_visible(
        origin + restir_gi_receiver_geometry_normal(receiver) * bias,
        direction,
        max(tMax - 2.0 * bias, bias),
        0u);
    GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_VISIBILITY_RAYS], 1u);
    return visibility == RESTIR_DI_VISIBILITY_VISIBLE;
}

vec3 evaluate_final(
    inout ProdRestirGiReservoir reservoir,
    RestirGiReceiver receiver,
    out vec3 direction,
    out float distance,
    out float confidence,
    out bool visible)
{
    confidence = 0.0;
    visible = false;
    if (!prod_reservoir_reusable(reservoir)) return vec3(0.0);
    if (prod_unpack_version_hash(reservoir) != restir_gi_receiver_version_hash(receiver)) {
        GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_VERSION_REJECT], 1u);
        return vec3(0.0);
    }
    float sourceTarget = prod_unpack_target(reservoir);
    if (!restir_gi_reconnect_sample(reservoir, receiver, pc.cameraPosition.xyz, direction, distance)) return vec3(0.0);
    float shiftedWeight = prod_shifted_reservoir_weight(
        reservoir, sourceTarget, prod_unpack_target(reservoir));
    if (!restir_gi_finite(shiftedWeight) || shiftedWeight <= 0.0) {
        GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_NON_FINITE], 1u);
        return vec3(0.0);
    }
    reservoir.reservoirData.x = shiftedWeight;

    uint flags = prod_unpack_flags(reservoir);
    bool reconnectedVisibilityKnown =
        (flags & (PROD_FLAG_VISIBILITY_KNOWN | PROD_FLAG_RECONNECTED_VISIBILITY)) ==
        (PROD_FLAG_VISIBILITY_KNOWN | PROD_FLAG_RECONNECTED_VISIBILITY);
    if (reconnectedVisibilityKnown) {
        visible = (flags & PROD_FLAG_VISIBLE) != 0u;
        if (!visible) return vec3(0.0);
    } else if (pc.visibilityRayBudget > 0u) {
        visible = trace_visibility(receiver, reservoir);
        if (!visible) return vec3(0.0);
        flags |= PROD_FLAG_VISIBLE | PROD_FLAG_VISIBILITY_KNOWN;
    } else {
        bool risky = (flags & PROD_FLAG_ALPHA_TESTED) != 0u ||
            prod_unpack_path_class(reservoir) == PROD_PATH_CLASS_GLOSSY_REUSABLE;
        if (risky) {
            GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_VISIBILITY_UNKNOWN], 1u);
            return vec3(0.0);
        }
        visible = (flags & PROD_FLAG_VISIBLE) != 0u;
        if (!visible) return vec3(0.0);
    }
    confidence = prod_unpack_confidence(reservoir) *
        (1.0 - exp(-prod_unpack_sample_count(reservoir) / 12.0)) *
        exp(-float(prod_unpack_age(reservoir)) / 48.0);
    vec3 contribution = reservoir.selectedIntegrandTarget.rgb * prod_final_weight(reservoir);
    if (!restir_gi_finite3(contribution)) {
        GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_NON_FINITE], 1u);
        return vec3(0.0);
    }
    return max(contribution, vec3(0.0));
}

void accumulate_grid_luma(ivec2 pixel, vec3 value) {
    uint fixedLuma = uint(round(sqrt(clamp(restir_gi_luma(value), 0.0, 1.0)) * 512.0));
    GI_COUNTER_ADD(restir_gi_counters[(pixel.x & 1) == 0 ? GI_COUNTER_GRID_LUMA_X_EVEN : GI_COUNTER_GRID_LUMA_X_ODD], fixedLuma);
    GI_COUNTER_ADD(restir_gi_counters[(pixel.y & 1) == 0 ? GI_COUNTER_GRID_LUMA_Y_EVEN : GI_COUNTER_GRID_LUMA_Y_ODD], fixedLuma);
}

vec3 class_color(uint c, float confidence) {
    vec3 color = c == PROD_PATH_CLASS_DIFFUSE_REUSABLE ? vec3(0.1, 0.9, 0.35) :
        c == PROD_PATH_CLASS_GLOSSY_REUSABLE ? vec3(1.0, 0.55, 0.08) :
        c == PROD_PATH_CLASS_ENVIRONMENT_REUSABLE ? vec3(0.2, 0.4, 1.0) :
        c == PROD_PATH_CLASS_EMISSIVE_REUSABLE ? vec3(1.0, 0.25, 0.95) : vec3(1.0, 0.1, 0.1);
    return color * (0.25 + 0.75 * confidence);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height) || (pc.enabled & 1u) == 0u) return;
    if (pc.debugView != 0u && !is_gi_debug(pc.debugView)) return;
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_INITIAL) return;
    bool debugGi = pc.debugView != 0u && is_gi_debug(pc.debugView);
    if (!active_tile_contains(pixel)) {
        if (debugGi) {
            imageStore(rawImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        }
        return;
    }

    uint pixelIndex = uint(pixel.y) * pc.width + uint(pixel.x);
    uint halfWidth = (pc.width + 1u) / 2u;
    uint currentIndex = pc.halfResolution != 0u
        ? uint(pixel.y / 2) * halfWidth + uint(pixel.x / 2) : pixelIndex;
    RestirGiReceiver receiver = receivers[pixelIndex];
    GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_PIXELS], 1u);

    ProdRestirGiReservoir current = current_reservoirs[currentIndex];
    ProdRestirGiReservoir spatial = spatial_reservoirs[pixelIndex];
    bool useSpatial = prod_reservoir_reusable(spatial);
    ProdRestirGiReservoir selected = useSpatial ? spatial : current;
    if (!debugGi && pc.referenceValidation == 0u &&
        (!restir_gi_receiver_valid_for_reuse(receiver) || !prod_reservoir_reusable(selected))) {
        GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_FALLBACK], 1u);
        return;
    }
    PathDataRecord pathData = path_data_buffer[pixelIndex];
    vec3 currentFallback = max(pathData.restir_gi_fallback_reactive.rgb, vec3(0.0));
    if (useSpatial) GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_SPATIAL_USED], 1u);
    else GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_CURRENT_USED], 1u);

    vec4 accumulated = accumulation_buffer[pixelIndex];
    float predictedReplacementStrength = 1.0;
    if (pc.debugView == 0u && pc.referenceValidation == 0u && (pc.enabled & 2u) != 0u) {
        float history = 1.0 - exp(-max(accumulated.a, 1.0) / 12.0);
        float motion = length(unpack_velocity_pixels(velocity_buffer[pixelIndex]));
        predictedReplacementStrength = clamp(
            prod_unpack_confidence(selected) *
            (1.0 - exp(-prod_unpack_sample_count(selected) / 12.0)) *
            exp(-float(prod_unpack_age(selected)) / 48.0) *
            history *
            (1.0 - smoothstep(0.0, 20.0, motion)),
            0.0,
            1.0);
        if (predictedReplacementStrength < pc.minFinalBlendStrength) {
            GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_FALLBACK], 1u);
            accumulate_grid_luma(pixel, currentFallback);
            pathData.emissive_residual.a = 1.0;
            path_data_buffer[pixelIndex] = pathData;
            return;
        }
    }

    vec3 direction = vec3(0.0, 1.0, 0.0);
    float distance = 65504.0;
    float confidence = 0.0;
    bool visible = false;
    vec3 finalSample = restir_gi_receiver_valid_for_reuse(receiver)
        ? evaluate_final(selected, receiver, direction, distance, confidence, visible)
        : vec3(0.0);
    bool estimatorValid = visible && restir_gi_luma(finalSample) > 0.0;
    if (!estimatorValid) {
        finalSample = currentFallback;
        confidence = 0.0;
        GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_FALLBACK], 1u);
    }

    uint pathClass = prod_unpack_path_class(selected);
    if (pathClass == PROD_PATH_CLASS_DIFFUSE_REUSABLE) GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_PATH_FINAL_DIFFUSE_REUSABLE], 1u);
    else if (pathClass == PROD_PATH_CLASS_GLOSSY_REUSABLE) GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_PATH_FINAL_GLOSSY_REUSABLE], 1u);
    else if (prod_path_class_reusable(pathClass)) GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_PATH_FINAL_OTHER], 1u);
    else GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_PATH_FINAL_INVALID], 1u);

    bool clamped = false;
    float finalLum = restir_gi_luma(finalSample);
    if (pc.referenceValidation == 0u && pc.fireflyClamp > 0.0 && finalLum > pc.fireflyClamp) {
        finalSample *= pc.fireflyClamp / max(finalLum, 1.0e-8);
        clamped = true;
        GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_CLAMP], 1u);
    }
    float replacementStrength = 1.0;
    if ((pc.enabled & 2u) != 0u && estimatorValid) {
        float history = 1.0 - exp(-max(accumulated.a, 1.0) / 12.0);
        float motion = length(unpack_velocity_pixels(velocity_buffer[pixelIndex]));
        replacementStrength = clamp(confidence * history * (1.0 - smoothstep(0.0, 20.0, motion)), 0.0, 1.0);
        if (pc.referenceValidation == 0u && replacementStrength < pc.minFinalBlendStrength) {
            estimatorValid = false;
            finalSample = currentFallback;
            confidence = 0.0;
            replacementStrength = 0.0;
            GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_FALLBACK], 1u);
        }
        if (replacementStrength < 0.999) GI_COUNTER_ADD(restir_gi_counters[GI_COUNTER_FINAL_STABILIZED], 1u);
    }
    vec3 replacement = mix(currentFallback, finalSample, replacementStrength);
    vec3 delta = replacement - currentFallback;
    float reactive = max(estimatorValid ? 1.0 - confidence : 1.0, clamped ? 1.0 : 0.0);
    accumulate_grid_luma(pixel, replacement);

    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_VALIDITY) {
        imageStore(rawImage, pixel, vec4(prod_reservoir_valid(current) ? 1.0 : 0.0, useSpatial ? 1.0 : 0.0, confidence, 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_AGE) {
        imageStore(rawImage, pixel, vec4(float(prod_unpack_age(selected)) / 255.0,
            prod_unpack_sample_count(selected) / 255.0, prod_unpack_target(selected) / 16.0, 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_TEMPORAL) {
        ProdRestirGiReservoir t = current;
        vec3 d; float h; float c; bool v;
        imageStore(rawImage, pixel, vec4(evaluate_final(t, receiver, d, h, c, v), 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_SPATIAL) {
        imageStore(rawImage, pixel, vec4(useSpatial ? finalSample : vec3(0.0), 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_FINAL) {
        imageStore(rawImage, pixel, vec4(replacement, 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_NORMAL) {
        imageStore(rawImage, pixel, vec4(normalize(selected.x2NormalRoughness.xyz) * 0.5 + 0.5, 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_HIT_DISTANCE) {
        imageStore(rawImage, pixel, vec4(vec3(clamp(log2(max(abs(selected.x2PositionDistance.w), 1.0e-3) + 1.0) / 16.0, 0.0, 1.0)), 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_PATH_CLASS) {
        imageStore(rawImage, pixel, vec4(class_color(pathClass, confidence), 1.0)); return;
    }
    if (pc.debugView == DEBUG_VIEW_RESTIR_GI_GRID) {
        vec3 tint = ((pixel.x ^ pixel.y) & 1) == 0 ? vec3(0.2, 0.55, 1.0) : vec3(1.0, 0.45, 0.15);
        imageStore(rawImage, pixel, vec4(tint * clamp(restir_gi_luma(replacement) * 8.0, 0.0, 1.0), 1.0)); return;
    }

    vec4 raw = imageLoad(rawImage, pixel);
    accumulated.rgb = max(accumulated.rgb + delta, vec3(0.0));
    accumulation_buffer[pixelIndex] = accumulated;
    float rawDeltaScale = pc.rawOutputIsCurrentSample > 0.5 ? 1.0 : 1.0 / max(accumulated.a, 1.0);
    imageStore(rawImage, pixel, vec4(max(raw.rgb + delta * rawDeltaScale, vec3(0.0)), 1.0));

    float specularWeight = clamp(pathData.restir_gi_fallback_reactive.a, 0.0, 1.0);
    pathData.indirect_diffuse.rgb = max(pathData.indirect_diffuse.rgb + delta * (1.0 - specularWeight), vec3(0.0));
    pathData.indirect_specular.rgb = max(pathData.indirect_specular.rgb + delta * specularWeight, vec3(0.0));
    pathData.indirect_diffuse.a = max(pathData.indirect_diffuse.a, confidence);
    pathData.emissive_residual.a = reactive;
    if (estimatorValid) {
        pathData.denoiser_hit_distance.x = distance;
        pathData.diffuse_ray_direction_hit_distance = vec4(direction, distance);
        if (specularWeight > 0.0) pathData.specular_ray_direction_hit_distance = vec4(direction, distance);
    }
    path_data_buffer[pixelIndex] = pathData;
}
