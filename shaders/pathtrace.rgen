vec3 restir_gi_receiver_position(RestirGiReceiver r) { return r.positionDepth.xyz; }
float restir_gi_receiver_depth(RestirGiReceiver r) { return r.positionDepth.w; }
vec3 restir_gi_receiver_normal(RestirGiReceiver r) { return normalize(r.normalRoughness.xyz); }
float restir_gi_receiver_roughness(RestirGiReceiver r) { return clamp(r.normalRoughness.w, 0.0, 1.0); }
vec3 restir_gi_receiver_geometry_normal(RestirGiReceiver r) { return normalize(r.geometryNormalMetal.xyz); }
float restir_gi_receiver_metallic(RestirGiReceiver r) { return clamp(r.geometryNormalMetal.w, 0.0, 1.0); }
vec3 restir_gi_receiver_albedo(RestirGiReceiver r) { return r.albedoOcclusion.rgb; }
float restir_gi_receiver_occlusion(RestirGiReceiver r) { return clamp(r.albedoOcclusion.a, 0.0, 1.0); }
uint restir_gi_receiver_material_id(RestirGiReceiver r) { return r.materialIds.x; }

#include "restir_gi_prod_packing.glsl"
#include "restir_gi_reconnection.glsl"

layout(set = 0, binding = 33) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 72, std430) buffer PsrGuideBuffer { PsrGuideRecord psr_guide_buffer[]; };
layout(set = 0, binding = 73, std430) buffer PsrGuideSignatureBuffer { uint psr_guide_signature_buffer[]; };
struct PackedRtxdiPtReservoir {
    uvec4 data0;
    uvec4 data1;
    uvec4 data2;
    uvec4 data3;
};
layout(set = 0, binding = 74, std430) buffer RtxdiPtInitialReservoirBuffer {
    PackedRtxdiPtReservoir rtxdi_pt_initial_reservoirs[];
};
layout(set = 0, binding = 75, std430) readonly buffer RtxdiPtPreviousReservoirBuffer {
    PackedRtxdiPtReservoir rtxdi_pt_previous_reservoirs[];
};
layout(location = 0) rayPayloadEXT RayPayload payload;
layout(location = 1) rayPayloadEXT uint shadow_occluded;
#if RTV_NATIVE2B_PIPELINE
layout(location = 2) rayPayloadEXT TerminalRayPayload terminal_payload;
#endif

const uint RAY_MASK_CAMERA = 0x01u;
const uint RAY_MASK_SHADOW = 0x02u;
const uint PATH_EVENT_NONE = 0u;
const uint PATH_EVENT_BSDF = 1u;
const uint PATH_EVENT_DELTA = 2u;

struct PathComponents {
    vec3 direct_light;
    vec3 indirect_light;
    vec3 emissive_light;
    vec3 visible_emissive_light;
    vec3 environment_light;
    vec3 restir_initial_direct_light;
    vec3 first_albedo;
    vec3 first_geom_normal; // Phase 2: geometric normal for GI receiver
    vec3 first_specular_albedo;
    vec3 restir_di_base_color;
    vec3 restir_di_f0;
    float first_roughness;
    float first_occlusion;
    float first_metallic;
    float first_alpha;
    uint first_alpha_mode;
    float first_transmission;
    uint first_mat_type;
    uint restir_di_material_supported;
    uint restir_di_material_pbr;
    uint restir_gi_receiver_supported;
    float first_light_pdf;
    float first_bsdf_pdf;
    float first_mis_weight;
    uint first_direct_sample_type;
    vec3 first_bounce_throughput;
    float secondary_env_miss;
    vec3 secondary_env_radiance;
    float emissive_continuation;
    float sun_mis_weight;
    float sun_light_pdf;
    float sun_previous_bsdf_pdf;
    float ris_raw_light_pdf;
    float ris_effective_light_pdf;
    float ris_pdf_ratio;
    vec3 restir_di_sample_position;
    vec3 restir_di_sample_radiance;
    vec3 restir_di_sample_normal;
    vec3 first_view_direction;
    float restir_di_sample_distance;
    uint restir_di_light_index;
    uint restir_di_light_kind;
    float caustic_transmissive_hits;
    float caustic_visible_paths;
    float caustic_blocked_paths;
#if RTV_REGIR_TRACE_ENABLED
    uint regir_query_count;
    uint regir_selected_light;
    float regir_reservoir_weight;
    float regir_mis_weight;
    float regir_effective_pdf;
    uint regir_canonical_used;
    uvec3 regir_query_cell;
    float regir_active_cell_occupancy;
    float regir_hash_collisions;
    float regir_spatial_input_weight;
    float regir_spatial_output_weight;
    uint regir_spatial_neighbor_count;
    uint regir_environment_source_kind;
    float regir_environment_source_pdf;
    float regir_environment_effective_pdf;
    vec3 regir_environment_direction;
    float regir_environment_mis_weight;
    float regir_environment_m;
    uint regir_environment_generation_mismatch;
#endif
    float first_specular_probability;
    float direct_light_hit_distance;
    float diffuse_hit_distance;
    float specular_hit_distance;
    float secondary_hit_distance;
    vec3 direct_light_direction;
    vec3 diffuse_ray_direction;
    vec3 specular_ray_direction;
    vec3 secondary_ray_direction;
    vec3 first_local_pos;
    vec3 first_barycentrics;
#if RTV_RTXDI_PT_REPLAY_ENABLED
    vec3 first_tangent;
    vec3 first_bitangent;
    vec2 first_uv;
    vec2 first_uv1;
#endif
    uint first_material_id;
    uint restir_gi_candidate_valid;
    vec3 restir_gi_candidate_position;
    vec3 restir_gi_candidate_normal;
    vec3 restir_gi_candidate_radiance;
    vec3 restir_gi_candidate_suffix_radiance;
    vec3 restir_gi_candidate_source_direction;
    vec3 restir_gi_receiver_position;
    float restir_gi_candidate_roughness;
    float restir_gi_candidate_hit_distance;
    float restir_gi_candidate_source_pdf;
    float restir_gi_candidate_target_pdf;
    uint restir_gi_candidate_path_class;
    uint restir_gi_candidate_reuse_flags;
    uint restir_gi_candidate_material_id;
#if RTV_RTXDI_PT_REPLAY_ENABLED
    uint restir_gi_candidate_path_length;
#endif
    uint bounce_count;
    uint instance_id;
    uint mesh_id;
    uint primitive_id;
    uint packed_velocity;
    uint packed_velocity_valid;
    uint psr_candidate;
    PsrGuideRecord psr_guide;
};

struct Ray {
    vec3 origin;
    vec3 direction;
    float time;
};


#include "pathtrace_camera_volume.glsl"
#include "pathtrace_restir.glsl"
#include "pathtrace_ray_queries.glsl"
#include "pathtrace_lighting.glsl"
#include "pathtrace_integrator.glsl"
#include "pathtrace_output.glsl"

PathDataRecord empty_adaptive_path_data() {
    PathDataRecord pathData;
    pathData.direct_diffuse = vec4(0.0);
    pathData.direct_specular = vec4(0.0, 0.0, 0.0, 65504.0);
    pathData.indirect_diffuse = vec4(0.0);
    pathData.indirect_specular = vec4(0.0, 0.0, 0.0, 65504.0);
    pathData.albedo_roughness_hit_confidence = vec4(0.5, 0.5, 0.5, 1.0);
    pathData.material_specular_albedo = vec4(0.5, 0.5, 0.5, 0.0);
    pathData.denoiser_hit_distance = vec4(65504.0, 65504.0, 65504.0, 0.0);
    pathData.diffuse_ray_direction_hit_distance = vec4(0.0, 0.0, 1.0, 65504.0);
    pathData.specular_ray_direction_hit_distance = vec4(0.0, 0.0, 1.0, 65504.0);
    pathData.emissive_residual = vec4(0.0);
    pathData.restir_gi_fallback_reactive = vec4(0.0);
    return pathData;
}

uvec2 encode_rtxdi_pt_snorm3x16(vec3 value) {
    uvec3 encoded = uvec3(round(clamp(value, vec3(-1.0), vec3(1.0)) * 32767.0 + 32767.0));
    return uvec2(
        (encoded.x & 0xffffu) | ((encoded.y & 0xffffu) << 16u),
        encoded.z & 0xffffu);
}

void store_rtxdi_pt_initial(uint pixelIndex, uint replaySeed, PathComponents components) {
    if (restir_di_raygen_params.rtxdiPtEnabled == 0u) {
        return;
    }

    PackedRtxdiPtReservoir packed;
    packed.data0 = uvec4(0u);
    packed.data1 = uvec4(0u);
    packed.data2 = uvec4(0u);
    packed.data3 = uvec4(0u);

    bool valid = components.restir_gi_candidate_valid != 0u &&
        components.restir_gi_candidate_source_pdf > 1.0e-8 &&
        components.restir_gi_candidate_target_pdf > 1.0e-8 &&
        !any(isnan(components.restir_gi_candidate_radiance)) &&
        !any(isinf(components.restir_gi_candidate_radiance)) &&
        !any(isnan(components.restir_gi_candidate_suffix_radiance)) &&
        !any(isinf(components.restir_gi_candidate_suffix_radiance));
    if (valid) {
        uvec2 packedNormal = encode_rtxdi_pt_snorm3x16(normalize(components.restir_gi_candidate_normal));
        float inversePdf = 1.0 / components.restir_gi_candidate_source_pdf;
#if RTV_RTXDI_PT_REPLAY_ENABLED
        uint pathLength = components.restir_gi_candidate_path_length != 0u
            ? components.restir_gi_candidate_path_length
            : clamp(components.bounce_count + 1u, 2u, 255u);
#else
        uint pathLength = clamp(components.bounce_count + 1u, 2u, 255u);
#endif
        uint rcVertexLength = min(pathLength, 2u);
        packed.data0 = uvec4(
            floatBitsToUint(components.restir_gi_candidate_position),
            floatBitsToUint(inversePdf));
        packed.data1 = uvec4(
            packedNormal.x,
            packedNormal.y | (packHalf2x16(vec2(0.0, 1.0)) & 0xffff0000u),
            floatBitsToUint(1.0),
            floatBitsToUint(max(components.restir_gi_candidate_source_pdf, 1.0e-8)));
        packed.data2 = uvec4(
            floatBitsToUint(max(components.restir_gi_candidate_suffix_radiance, vec3(0.0))),
            (rcVertexLength << 8u) | (pathLength << 16u));
        packed.data3 = uvec4(
            floatBitsToUint(max(components.restir_gi_candidate_radiance, vec3(0.0))),
            replaySeed);
    }
    rtxdi_pt_initial_reservoirs[pixelIndex] = packed;
}

#if RTV_RTXDI_PT_REPLAY_ENABLED
bool replay_rtxdi_pt_one_bounce(
    uint pixelIndex,
    ivec2 coords,
    ivec2 dims,
    float rayTime,
    vec3 receiverPosition,
    vec3 receiverNormal,
    float receiverDepth,
    inout PathComponents components,
    out uint replaySeedOut) {
    replaySeedOut = 0u;
    if (restir_di_raygen_params.rtxdiPtEnabled == 0u ||
        restir_di_raygen_params.rtxdiPtReplayEnabled == 0u ||
        ((pixelIndex ^ camera.temporal_frame_index) & 7u) != 0u ||
        components.first_material_id == 0xffffffffu ||
        components.first_roughness < 0.2 ||
        components.first_transmission > 1.0e-5 ||
        components.restir_gi_receiver_supported == 0u) {
        return false;
    }

    PackedRtxdiPtReservoir previous = rtxdi_pt_previous_reservoirs[pixelIndex];
    float previousM = unpackHalf2x16(previous.data1.y).y;
    uint previousAge = previous.data2.w & 0x1fu;
    uint previousPathLength = (previous.data2.w >> 16u) & 0xffu;
    if (!(previousM > 0.0) || previousAge > 1u || previousPathLength != 2u) {
        return false;
    }

    RayPayload primaryHit;
    primaryHit.hit = 1u;
    primaryHit.t = receiverDepth;
    primaryHit.world_pos = receiverPosition;
    primaryHit.material_id = components.first_material_id;
    primaryHit.local_pos = components.first_local_pos;
    primaryHit.geom_normal = components.first_geom_normal;
    primaryHit.front_face = 1u;
    primaryHit.normal = receiverNormal;
    primaryHit.instance_id = components.instance_id;
    primaryHit.mesh_id = components.mesh_id;
    primaryHit.primitive_id = components.primitive_id;
    primaryHit.picking = 0u;
    primaryHit.barycentrics = components.first_barycentrics;
    primaryHit.uv = components.first_uv;
    primaryHit.uv1 = components.first_uv1;
    primaryHit.tangent = components.first_tangent;
    primaryHit.bitangent = components.first_bitangent;
    primaryHit.vertex_color = vec4(1.0);

    Material material = material_for_hit(primaryHit, -normalize(components.first_view_direction));
    if (material_is_delta(material) || material_is_transmissive(material)) {
        return false;
    }

    uint replayRng = previous.data3.w;
    float bsdfPdf = 0.0;
    vec3 wo = normalize(components.first_view_direction);
    vec3 wi = sample_brdf(
        replayRng,
        material,
        wo,
        receiverNormal,
        primaryHit.tangent,
        primaryHit.bitangent,
        bsdfPdf);
    float nDotL = max(dot(receiverNormal, wi), 0.0);
    if (!(bsdfPdf > 1.0e-6) || !(nDotL > 1.0e-6)) {
        return false;
    }

    vec3 bsdf = eval_brdf(
        material,
        wo,
        wi,
        receiverNormal,
        primaryHit.tangent,
        primaryHit.bitangent);
    vec3 primaryThroughput = bsdf * nDotL / bsdfPdf;
    if (any(isnan(primaryThroughput)) || any(isinf(primaryThroughput)) ||
        max(max(primaryThroughput.r, primaryThroughput.g), primaryThroughput.b) <= 0.0) {
        return false;
    }

    Ray replayRay;
    replayRay.origin = receiverPosition + receiverNormal * shadow_self_hit_epsilon();
    replayRay.direction = wi;
    replayRay.time = rayTime;
    bool replayDidHit = false;
    float replayDepth = 1.0e30;
    vec3 replayNormal = vec3(0.0, 1.0, 0.0);
    vec3 replayPosition = vec3(0.0);
    PathComponents replayComponents;
    vec3 replayRadiance = trace_path(
        replayRay,
        replayRng,
        pixelIndex,
        coords,
        dims,
        replayDidHit,
        replayDepth,
        replayNormal,
        replayPosition,
        replayComponents);
    if (!replayDidHit || any(isnan(replayRadiance)) || any(isinf(replayRadiance))) {
        return false;
    }

    float distance = length(replayPosition - receiverPosition);
    vec3 sourceDirection = distance > 1.0e-4 ? (replayPosition - receiverPosition) / distance : vec3(0.0);
    if (!(distance > 1.0e-4) || max(dot(replayNormal, -sourceDirection), 0.0) <= 1.0e-5) {
        return false;
    }

    RestirGiReceiver sourceReceiver;
    sourceReceiver.positionDepth = vec4(receiverPosition, receiverDepth);
    sourceReceiver.normalRoughness = vec4(receiverNormal, components.first_roughness);
    sourceReceiver.geometryNormalMetal = vec4(components.first_geom_normal, components.first_metallic);
    sourceReceiver.albedoOcclusion = vec4(components.restir_di_base_color, components.first_occlusion);
    sourceReceiver.materialIds = uvec4(components.first_material_id, components.instance_id, components.mesh_id, components.primitive_id);
    sourceReceiver.motion = uvec4(0u);
    vec3 receiverFactor = restir_gi_receiver_factor(sourceReceiver, camera.pos.xyz, sourceDirection);
    float measurePdf = restir_gi_source_measure_pdf(bsdfPdf, sourceDirection, replayNormal, distance, false);
    float measureFactor = max(dot(replayNormal, -sourceDirection), 0.0) / max(distance * distance, 1.0e-8);
    vec3 selectedIntegrand = max(replayRadiance * primaryThroughput, vec3(0.0)) * measurePdf;
    float targetPdf = restir_gi_luma(selectedIntegrand);
    vec3 suffix = selectedIntegrand / max(receiverFactor * measureFactor, vec3(1.0e-8));
    if (!(measurePdf > 1.0e-10) || !(targetPdf > 1.0e-8) || !restir_gi_finite3(suffix)) {
        return false;
    }

    components.restir_gi_candidate_valid = 1u;
    components.restir_gi_candidate_position = replayPosition;
    components.restir_gi_candidate_normal = replayNormal;
    components.restir_gi_candidate_radiance = selectedIntegrand;
    components.restir_gi_candidate_suffix_radiance = suffix;
    components.restir_gi_candidate_source_direction = sourceDirection;
    components.restir_gi_receiver_position = receiverPosition;
    components.restir_gi_candidate_roughness = replayComponents.first_roughness;
    components.restir_gi_candidate_hit_distance = min(distance, 65504.0);
    components.restir_gi_candidate_source_pdf = measurePdf;
    components.restir_gi_candidate_target_pdf = targetPdf;
    components.restir_gi_candidate_path_class = replayComponents.first_roughness < 0.65
        ? PROD_PATH_CLASS_GLOSSY_REUSABLE
        : PROD_PATH_CLASS_DIFFUSE_REUSABLE;
    components.restir_gi_candidate_reuse_flags = 0u;
    components.restir_gi_candidate_material_id = components.first_material_id;
    components.restir_gi_candidate_path_length = 2u;
    replaySeedOut = previous.data3.w;
    return true;
}
#endif

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uvec2 size = gl_LaunchSizeEXT.xy;
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    uint pixel_index = pixel.y * size.x + pixel.x;
    uint requestedSpp = clamp(camera.path_trace_controls.x, 1u, 64u);
    uint effectiveSpp = camera.path_trace_controls.y != 0u ? 1u : requestedSpp;
    if (adaptive_sample_count_enabled()) {
        effectiveSpp = min(adaptive_sampling_sample_count[pixel_index], 64u);
    }
    uint rng = sample_dimension_seed(ivec2(pixel), camera.temporal_frame_index, 0u, SAMPLE_DIM_PATH_SEED);
    uint pathReplaySeed = rng;
    Ray ray = make_camera_ray(pixel, size, ivec2(pixel), 0u);
    if (effectiveSpp == 0u) {
        uint packedVelocity = compute_sky_velocity(ray.direction, ivec2(size));
        imageStore(output_color, ivec2(pixel), vec4(0.0, 0.0, 0.0, -1.0));
        variance_buffer[pixel_index] = pack_variance(0.0);
        depth_normal_buffer[pixel_index] = pack_depth_normal(65504.0, vec3(0.0, 0.0, 1.0), 1.0);
        world_position_buffer[pixel_index] = uvec2(0u);
        velocity_buffer[pixel_index] = packedVelocity;
        path_data_buffer[pixel_index] = empty_adaptive_path_data();
        psr_guide_buffer[pixel_index] = psr_invalid_guide();
        psr_guide_signature_buffer[pixel_index] = 0u;
        entity_id_buffer[pixel_index] = 0xffffffffu;
        if (restir_mode() != 0u) {
            restir_reservoirs[pixel_index] = empty_restir_reservoir();
        }
        if (restir_gi_enabled() || restir_gi_debug_view()) {
            restir_gi_reservoirs[pixel_index] = empty_restir_gi_reservoir();
        }
        if (restir_di_raygen_params.width != 0u) {
            restir_di_initial_reservoirs[pixel_index] = restir_di_empty_reservoir();
        }
        if (restir_di_raygen_params.rtxdiPtEnabled != 0u) {
            rtxdi_pt_initial_reservoirs[pixel_index] = PackedRtxdiPtReservoir(
                uvec4(0u), uvec4(0u), uvec4(0u), uvec4(0u));
        }
        return;
    }
    float invSpp = 1.0 / float(effectiveSpp);

    bool did_hit;
    float hit_depth;
    vec3 hit_normal;
    vec3 hit_position;
    PathComponents components;
    vec3 sample_color;
#if RTV_NATIVE2B_PIPELINE
    sample_color = trace_path(ray, rng, pixel_index, ivec2(pixel), ivec2(size), did_hit, hit_depth, hit_normal, hit_position, components);
#else
    if (effectiveSpp <= 1u) {
        sample_color = trace_path(ray, rng, pixel_index, ivec2(pixel), ivec2(size), did_hit, hit_depth, hit_normal, hit_position, components);
    } else {
        sample_color = vec3(0.0);
        PathComponents first_components;
        bool first_did_hit = false;
        float first_hit_depth = 1.0e30;
        vec3 first_hit_normal = vec3(0.0, 1.0, 0.0);
        vec3 first_hit_position = vec3(0.0);
        vec3 accumulated_direct = vec3(0.0);
        vec3 accumulated_indirect = vec3(0.0);
        vec3 accumulated_emissive = vec3(0.0);
        vec3 accumulated_visible_emissive = vec3(0.0);
        vec3 accumulated_environment = vec3(0.0);
        vec3 accumulated_restir_direct = vec3(0.0);
        vec3 accumulated_caustic_debug = vec3(0.0);

        for (uint sppIndex = 0u; sppIndex < 64u; ++sppIndex) {
            if (sppIndex >= effectiveSpp) {
                break;
            }

            ivec2 sample_coords = ivec2(pixel) + ivec2(int(sppIndex) * 4099, int(sppIndex) * 9176);
            uint sample_rng = rng ^ sample_dimension_seed(sample_coords, camera.temporal_frame_index, sppIndex, SAMPLE_DIM_PATH_SEED + 23u);
            Ray sample_ray = make_camera_ray(pixel, size, sample_coords, sppIndex);
            PathComponents sample_components;
            bool sample_did_hit;
            float sample_hit_depth;
            vec3 sample_hit_normal;
            vec3 sample_hit_position;
            vec3 path_sample = trace_path(sample_ray, sample_rng, pixel_index, sample_coords, ivec2(size), sample_did_hit, sample_hit_depth, sample_hit_normal, sample_hit_position, sample_components);
            sample_color += path_sample;
            accumulated_direct += sample_components.direct_light;
            accumulated_indirect += sample_components.indirect_light;
            accumulated_emissive += sample_components.emissive_light;
            accumulated_visible_emissive += sample_components.visible_emissive_light;
            accumulated_environment += sample_components.environment_light;
            accumulated_restir_direct += sample_components.restir_initial_direct_light;
            accumulated_caustic_debug += vec3(
                sample_components.caustic_visible_paths,
                sample_components.caustic_transmissive_hits,
                sample_components.caustic_blocked_paths);

            if (sppIndex == 0u) {
                pathReplaySeed = sample_rng;
                first_components = sample_components;
                first_did_hit = sample_did_hit;
                first_hit_depth = sample_hit_depth;
                first_hit_normal = sample_hit_normal;
                first_hit_position = sample_hit_position;
            }
        }

        sample_color *= invSpp;
        components = first_components;
        components.direct_light = accumulated_direct * invSpp;
        components.indirect_light = accumulated_indirect * invSpp;
        components.emissive_light = accumulated_emissive * invSpp;
        components.visible_emissive_light = accumulated_visible_emissive * invSpp;
        components.environment_light = accumulated_environment * invSpp;
        components.restir_initial_direct_light = accumulated_restir_direct * invSpp;
        components.caustic_visible_paths = accumulated_caustic_debug.x * invSpp;
        components.caustic_transmissive_hits = accumulated_caustic_debug.y * invSpp;
        components.caustic_blocked_paths = accumulated_caustic_debug.z * invSpp;
        did_hit = first_did_hit;
        hit_depth = first_hit_depth;
        hit_normal = first_hit_normal;
        hit_position = first_hit_position;
    }
#endif
    vec4 previous = (camera.frame_count <= 1u || camera.path_tracing_enabled == 0u) ? vec4(0.0) : accumulation_buffer[pixel_index];
    vec3 previous_average = previous.rgb / max(previous.a, 1.0);
    vec3 unclamped_sample_color = max(sample_color, vec3(0.0));
    sample_color = clamp_firefly_sample(sample_color, previous_average, camera.frame_count);
    float sampleClampScale = 1.0;
    float unclampedSampleLum = dot(unclamped_sample_color, vec3(0.2126, 0.7152, 0.0722));
    float clampedSampleLum = dot(max(sample_color, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
    if (unclampedSampleLum > 1.0e-6 && clampedSampleLum < unclampedSampleLum) {
        sampleClampScale = clamp(clampedSampleLum / unclampedSampleLum, 0.0, 1.0);
    }
    vec3 rr_sample_color = sample_color;
    vec4 accumulated = previous + vec4(sample_color, 1.0);
    accumulation_buffer[pixel_index] = accumulated;
    vec3 average = camera.path_tracing_enabled != 0u ? accumulated.rgb / max(accumulated.a, 1.0) : sample_color;

    float lum = dot(sample_color, vec3(0.2126, 0.7152, 0.0722));
    float avgLum = dot(average, vec3(0.2126, 0.7152, 0.0722));
    variance_buffer[pixel_index] = pack_variance(abs(lum - avgLum));
    depth_normal_buffer[pixel_index] = pack_depth_normal(hit_depth, hit_normal, components.first_roughness);
    world_position_buffer[pixel_index] = did_hit ? pack_world_position(hit_position) : uvec2(0u);
    float pathSpecularWeight = clamp(components.first_specular_probability, 0.0, 1.0);
    float pathDiffuseWeight = 1.0 - pathSpecularWeight;
    float confidence = did_hit
        ? clamp(1.0 - abs(lum - avgLum) / (max(max(lum, avgLum), 0.0) + 1.0), 0.0, 1.0)
        : 0.0;
    float primaryHitDistance = did_hit ? min(hit_depth, 65504.0) : 65504.0;
    vec3 directDiffuseSignal = components.direct_light * pathDiffuseWeight * sampleClampScale;
    vec3 directSpecularSignal = components.direct_light * pathSpecularWeight * sampleClampScale;
    vec3 indirectDiffuseSignal = (components.indirect_light + components.environment_light) * pathDiffuseWeight * sampleClampScale;
    vec3 indirectSpecularSignal = (components.indirect_light + components.environment_light) * pathSpecularWeight * sampleClampScale;
    float directDiffuseWeight = luminance(max(directDiffuseSignal, vec3(0.0)));
    float directSpecularWeight = luminance(max(directSpecularSignal, vec3(0.0)));
    float indirectDiffuseWeight = luminance(max(indirectDiffuseSignal, vec3(0.0)));
    float indirectSpecularWeight = luminance(max(indirectSpecularSignal, vec3(0.0)));
    components.diffuse_hit_distance = did_hit
        ? weighted_effect_hit_distance(
            directDiffuseWeight,
            components.direct_light_hit_distance,
            indirectDiffuseWeight,
            components.secondary_hit_distance,
            primaryHitDistance)
        : 0.0;
    components.specular_hit_distance = did_hit
        ? sanitize_effect_hit_distance(components.secondary_hit_distance, 65504.0)
        : 0.0;
    vec3 fallbackRayDirection = normalize(ray.direction);
    components.diffuse_ray_direction = did_hit
        ? select_effect_ray_direction(
            directDiffuseWeight,
            components.direct_light_direction,
            indirectDiffuseWeight,
            components.secondary_ray_direction,
            fallbackRayDirection)
        : fallbackRayDirection;
    components.specular_ray_direction = did_hit
        ? select_effect_ray_direction(
            directSpecularWeight,
            components.direct_light_direction,
            indirectSpecularWeight,
            components.secondary_ray_direction,
            fallbackRayDirection)
        : fallbackRayDirection;
    PathDataRecord pathData;
    float emissiveSignal = luminance(components.emissive_light * sampleClampScale);
    pathData.direct_diffuse = vec4(directDiffuseSignal, emissiveSignal);
    pathData.direct_specular = vec4(directSpecularSignal, primaryHitDistance);
    pathData.indirect_diffuse = vec4(indirectDiffuseSignal, confidence);
    pathData.indirect_specular = vec4(indirectSpecularSignal, did_hit ? components.secondary_hit_distance : 65504.0);
    pathData.albedo_roughness_hit_confidence = vec4(
        did_hit ? components.first_albedo : vec3(0.5),
        did_hit ? components.first_roughness : 1.0);
    pathData.material_specular_albedo = vec4(did_hit ? components.first_specular_albedo : vec3(0.5), did_hit ? 1.0 : 0.0);
    pathData.denoiser_hit_distance = vec4(
        components.diffuse_hit_distance,
        components.specular_hit_distance,
        primaryHitDistance,
        did_hit ? 1.0 : 0.0);
    pathData.diffuse_ray_direction_hit_distance = vec4(
        components.diffuse_ray_direction,
        components.diffuse_hit_distance);
    pathData.specular_ray_direction_hit_distance = vec4(
        components.specular_ray_direction,
        components.specular_hit_distance);
    pathData.emissive_residual = vec4(max(components.visible_emissive_light * sampleClampScale, vec3(0.0)), 0.0);
    vec3 restirGiCurrentFallback = components.restir_gi_candidate_valid != 0u
        ? (components.restir_gi_candidate_radiance * sampleClampScale) / max(components.restir_gi_candidate_source_pdf, 1.0e-8)
        : vec3(0.0);
    pathData.restir_gi_fallback_reactive = vec4(max(restirGiCurrentFallback, vec3(0.0)), pathSpecularWeight);
    path_data_buffer[pixel_index] = pathData;
    uint packedVelocity = did_hit
        ? (components.packed_velocity_valid != 0u
            ? components.packed_velocity
            : compute_surface_velocity(
                hit_position,
                components.first_local_pos,
                components.instance_id,
                components.mesh_id,
                components.primitive_id,
                components.first_barycentrics,
                ivec2(size)))
        : compute_sky_velocity(ray.direction, ivec2(size));
    velocity_buffer[pixel_index] = packedVelocity;
    if (psr_guide_valid(components.psr_guide)) {
        components.psr_guide.geometry.w = psr_guide_active(components.psr_guide)
            ? components.psr_guide.geometry.w
            : packedVelocity;
    }
    psr_guide_buffer[pixel_index] = components.psr_guide;
    psr_guide_signature_buffer[pixel_index] = psr_guide_signature(components.psr_guide);
    store_initial_restir_reservoir(pixel_index, ivec2(pixel), ivec2(size), packedVelocity, components);
    if (!native2b_kernel_enabled() || restir_gi_enabled() || restir_gi_debug_view()) {
        PathComponents restirGiComponents = components;
        if (sampleClampScale < 0.999999 && restirGiComponents.restir_gi_candidate_valid != 0u) {
            restirGiComponents.restir_gi_candidate_radiance *= sampleClampScale;
            restirGiComponents.restir_gi_candidate_suffix_radiance *= sampleClampScale;
            restirGiComponents.restir_gi_candidate_target_pdf =
                max(luminance(max(restirGiComponents.restir_gi_candidate_radiance, vec3(0.0))), 1.0e-8);
        }
        store_restir_gi_receiver(pixel_index, ivec2(pixel), packedVelocity, components, hit_position, hit_normal, hit_depth, did_hit);
#if RTV_RTXDI_PT_REPLAY_ENABLED
        uint ptReplaySeed = pathReplaySeed;
        if (did_hit && restir_di_raygen_params.rtxdiPtEnabled != 0u) {
            uint replayedSeed = 0u;
            if (replay_rtxdi_pt_one_bounce(
                pixel_index,
                ivec2(pixel),
                ivec2(size),
                ray.time,
                hit_position,
                hit_normal,
                hit_depth,
                restirGiComponents,
                replayedSeed)) {
                ptReplaySeed = replayedSeed;
            }
        }
#else
        uint ptReplaySeed = pathReplaySeed;
#endif
        store_initial_restir_gi_reservoir(pixel_index, ivec2(pixel), ivec2(size), packedVelocity, restirGiComponents);
        store_rtxdi_pt_initial(pixel_index, ptReplaySeed, restirGiComponents);
    }
    if (restir_di_raygen_params.width != 0u) {
        store_new_restir_di(pixel_index, components, hit_position, hit_normal, hit_depth, did_hit);
    }

    entity_id_buffer[pixel_index] = did_hit && components.instance_id != 0xffffffffu
        ? components.instance_id
        : 0xffffffffu;

    bool rr_active = camera.motion_blur_controls.w > 0.5;
    vec3 rr_input_color = rr_sample_color;
    vec3 output_value = rr_active ? rr_input_color : average;
#if RTV_BEAUTY_OUTPUT_ONLY
    imageStore(output_color, ivec2(pixel), vec4(output_value, 1.0));
    return;
#else
    if (debug_params.view == 2u) {
        output_value = did_hit ? hit_normal * 0.5 + vec3(0.5) : vec3(0.0);
    } else if (debug_params.view == 5u) {
        output_value = vec3(clamp(hit_depth / 8.0, 0.0, 1.0));
    } else if (debug_params.view == 6u) {
        output_value = vec3(components.first_roughness);
    } else if (debug_params.view == 7u) {
        output_value = components.direct_light * debug_params.scale;
    } else if (debug_params.view == 8u) {
        output_value = components.indirect_light * debug_params.scale;
    } else if (debug_params.view == 9u) {
        output_value = components.emissive_light * debug_params.scale;
    } else if (debug_params.view == 10u) {
        output_value = components.environment_light * debug_params.scale;
    } else if (debug_params.view == 11u) {
        // Hardware RT does not expose implementation traversal counters.
        output_value = unsupported_hardware_rt_debug_pattern(pixel, debug_params.view);
    } else if (debug_params.view == 12u) {
        // Hardware RT does not expose implementation BVH depth.
        output_value = unsupported_hardware_rt_debug_pattern(pixel, debug_params.view);
    } else if (debug_params.view == 13u) {
        output_value = did_hit && components.instance_id != 0xffffffffu ? id_color(components.instance_id) : vec3(0.0);
    } else if (debug_params.view == 14u) {
        output_value = did_hit && components.mesh_id != 0xffffffffu ? id_color(components.mesh_id) : vec3(0.0);
    } else if (debug_params.view == 15u) {
        // Hardware RT does not expose implementation TLAS traversal counters.
        output_value = unsupported_hardware_rt_debug_pattern(pixel, debug_params.view);
    } else if (debug_params.view == 16u) {
        // The software traversal comparison view is unavailable in the hardware RT-only renderer.
        output_value = unsupported_hardware_rt_debug_pattern(pixel, debug_params.view);
    } else if (debug_params.view == 17u) {
        output_value = vec3(clamp(log2(max(components.first_light_pdf, 0.0) + 1.0) / 8.0, 0.0, 1.0));
    } else if (debug_params.view == 18u) {
        output_value = vec3(clamp(log2(max(components.first_bsdf_pdf, 0.0) + 1.0) / 8.0, 0.0, 1.0));
    } else if (debug_params.view == 19u) {
        output_value = vec3(clamp(components.first_mis_weight, 0.0, 1.0));
    } else if (debug_params.view == 20u) {
        output_value = components.first_direct_sample_type == 1u
            ? vec3(1.0, 0.45, 0.05)
            : (components.first_direct_sample_type == 2u ? vec3(0.05, 0.45, 1.0) : (components.first_direct_sample_type == 3u ? vec3(1.0, 0.95, 0.1) : vec3(0.0)));
    } else if (debug_params.view == 134u) {
        output_value = regir_enabled()
            ? vec3(
                clamp(float(regir_params.grid_dimensions_reservoirs.x) / 64.0, 0.0, 1.0),
                clamp(float(regir_params.grid_dimensions_reservoirs.y) / 64.0, 0.0, 1.0),
                clamp(float(regir_params.grid_dimensions_reservoirs.z) / 64.0, 0.0, 1.0))
            : vec3(0.0);
    } else if (debug_params.view == 135u) {
        output_value = vec3(clamp(log2(max(components.regir_reservoir_weight, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 136u) {
        output_value = components.regir_selected_light != 0xffffffffu
            ? id_color(components.regir_selected_light + 1u)
            : vec3(0.0);
    } else if (debug_params.view == 137u) {
        float denom = max(float(regir_params.grid_dimensions_reservoirs.w) * 8.0, 1.0);
        output_value = vec3(clamp(float(components.regir_query_count) / denom, 0.0, 1.0));
    } else if (debug_params.view == 138u) {
        output_value = vec3(clamp(components.regir_mis_weight, 0.0, 1.0));
    } else if (debug_params.view == 139u) {
        output_value = vec3(clamp(log2(max(components.regir_effective_pdf, 0.0) + 1.0) / 8.0, 0.0, 1.0));
    } else if (debug_params.view == 140u) {
        output_value = components.regir_canonical_used != 0u ? vec3(0.1, 0.9, 0.25) : vec3(0.1, 0.25, 0.95);
    } else if (debug_params.view == 141u) {
        uvec3 dims = max(regir_params.grid_dimensions_reservoirs.xyz, uvec3(1u));
        output_value = regir_enabled()
            ? vec3(components.regir_query_cell) / vec3(max(dims - uvec3(1u), uvec3(1u)))
            : vec3(0.0);
    } else if (debug_params.view == 142u) {
        output_value = vec3(clamp(components.regir_active_cell_occupancy, 0.0, 1.0));
    } else if (debug_params.view == 143u) {
        output_value = vec3(clamp(components.regir_hash_collisions, 0.0, 1.0));
    } else if (debug_params.view == 144u) {
        output_value = vec3(clamp(log2(max(components.regir_spatial_input_weight, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 145u) {
        output_value = vec3(clamp(log2(max(components.regir_spatial_output_weight, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 146u) {
        float denom = max(float(regir_params.grid_dimensions_reservoirs.w) * 8.0 * max(regir_params.query_controls.z, 1.0), 1.0);
        output_value = vec3(clamp(float(components.regir_spatial_neighbor_count) / denom, 0.0, 1.0));
    } else if (debug_params.view == 147u) {
        if (components.regir_environment_generation_mismatch != 0u) {
            output_value = vec3(1.0, 0.05, 0.0);
        } else if (components.regir_environment_source_kind == 1u) {
            output_value = vec3(0.1, 0.45, 1.0);
        } else if (components.regir_environment_source_kind == 2u) {
            output_value = vec3(0.1, 0.9, 0.25);
        } else if (components.regir_environment_source_kind == 3u) {
            output_value = vec3(1.0, 0.85, 0.15);
        } else if (components.regir_environment_source_kind == 4u) {
            output_value = vec3(1.0, 0.2, 0.75);
        } else {
            output_value = vec3(0.0);
        }
    } else if (debug_params.view == 148u) {
        float sourcePdf = clamp(log2(max(components.regir_environment_source_pdf, 0.0) + 1.0) / 8.0, 0.0, 1.0);
        float effectivePdf = clamp(log2(max(components.regir_environment_effective_pdf, 0.0) + 1.0) / 8.0, 0.0, 1.0);
        output_value = vec3(sourcePdf, effectivePdf, abs(sourcePdf - effectivePdf));
    } else if (debug_params.view == 149u) {
        output_value = components.regir_environment_effective_pdf > 0.0
            ? normalize(components.regir_environment_direction) * 0.5 + vec3(0.5)
            : vec3(0.0);
    } else if (debug_params.view == 150u) {
        output_value = vec3(
            clamp(components.regir_environment_mis_weight, 0.0, 1.0),
            clamp(log2(max(components.regir_environment_m, 0.0) + 1.0) / 8.0, 0.0, 1.0),
            components.regir_environment_effective_pdf > 0.0 ? 1.0 : 0.0);
    } else if (debug_params.view == 151u) {
        output_value = components.regir_environment_generation_mismatch != 0u
            ? vec3(1.0, 0.0, 0.0)
            : (components.regir_environment_effective_pdf > 0.0 ? vec3(0.0, 0.9, 0.2) : vec3(0.0));
    } else if (debug_params.view == 21u) {
        output_value = did_hit ? components.first_albedo : vec3(0.0);
    } else if (debug_params.view == 89u) {
        output_value = did_hit ? vec3(clamp(components.first_occlusion, 0.0, 1.0)) : vec3(0.0);
    } else if (debug_params.view == 102u) {
        output_value = did_hit ? vec3(clamp(components.first_metallic, 0.0, 1.0)) : vec3(0.0);
    } else if (debug_params.view == 103u) {
        // Material alpha: grayscale opacity; tint by alpha mode (green=opaque, blue=mask, red=blend).
        float alpha = did_hit ? clamp(components.first_alpha, 0.0, 1.0) : 0.0;
        vec3 modeTint = components.first_alpha_mode == 1u
            ? vec3(0.2, 0.4, 1.0)
            : (components.first_alpha_mode == 2u ? vec3(1.0, 0.3, 0.2) : vec3(0.3, 1.0, 0.4));
        output_value = did_hit ? alpha * modeTint : vec3(0.0);
    } else if (debug_params.view == 104u) {
        output_value = did_hit ? vec3(clamp(components.first_transmission, 0.0, 1.0)) : vec3(0.0);
    } else if (debug_params.view == 105u) {
        // Material type/workflow id mapped to a distinct color per closure type.
        output_value = did_hit ? id_color(components.first_mat_type + 1u) : vec3(0.0);
    } else if (debug_params.view == 106u) {
        // RestirDiSelectedLight — visualize light type by color
        uint lightKind = restir_di_light_kind(restir_di_initial_reservoirs[pixel_index]);
        output_value = id_color(lightKind + 1u);
    } else if (debug_params.view == 107u) {
        // RestirDiTarget — target function luminance (normalized)
        float targetLum = restir_di_target(restir_di_initial_reservoirs[pixel_index]);
        output_value = vec3(clamp(targetLum / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 108u) {
        // RestirDiSourcePdf
        float srcPdf = restir_di_source_pdf(restir_di_initial_reservoirs[pixel_index]);
        output_value = vec3(clamp(log2(max(srcPdf, 1e-6) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 109u) {
        // RestirDiVisibility — green=visible, red=occluded, blue=unknown
        uint vis = restir_di_visibility(restir_di_initial_reservoirs[pixel_index]);
        output_value = vis == RESTIR_DI_VISIBILITY_VISIBLE ? vec3(0,1,0) :
                       vis == RESTIR_DI_VISIBILITY_OCCLUDED ? vec3(1,0,0) :
                       vec3(0,0,1);
    } else if (debug_params.view == 110u) {
        // RestirDiRejectionReason — color by rejection flag bits
        uint rej = restir_di_rejection_flags(restir_di_initial_reservoirs[pixel_index]);
        output_value = vec3(float(rej & 1u), float((rej>>1u)&1u), float((rej>>2u)&1u));
    } else if (debug_params.view == 111u) {
        // RestirDiTemporalAcceptance — show temporal selection
        float prevW = restir_di_previous_weight(restir_di_initial_reservoirs[pixel_index]);
        output_value = vec3(prevW, 1.0 - prevW, 0.0);
    } else if (debug_params.view == 113u) {
        // RestirDiFinalContribution — show direct light contribution
        RestirDiReservoir finalRes = restir_di_initial_reservoirs[pixel_index];
        output_value = restir_di_reservoir_valid(finalRes)
            ? restir_di_sample_radiance(finalRes) * restir_di_weight_sum(finalRes) /
                max(float(max(restir_di_m(finalRes), 1u)) * restir_di_target(finalRes), 1.0e-6) * debug_params.scale
            : vec3(0.0);
    } else if (debug_params.view == 114u) {
        // RestirDiReceiverPosition — world-space position
        RestirDiReceiver recv = restir_di_receivers[pixel_index];
        output_value = fract(recv.worldPosition_depth.xyz * 0.25);
    } else if (debug_params.view == 115u) {
        // RestirDiReceiverNormal
        RestirDiReceiver recv = restir_di_receivers[pixel_index];
        output_value = recv.normal_roughness.xyz * 0.5 + vec3(0.5);
    } else if (debug_params.view == 116u) {
        // RestirDiLightVersion
        uint lv = restir_di_light_version(restir_di_initial_reservoirs[pixel_index]);
        output_value = vec3(float(lv & 0xffu) / 255.0);
    } else if (debug_params.view == 117u || debug_params.view == 118u || debug_params.view == 119u) {
        // RestirDiInitial/Temporal/SpatialReservoir — contribution debug
        RestirDiReservoir diRes = restir_di_initial_reservoirs[pixel_index];
        output_value = restir_di_reservoir_valid(diRes)
            ? restir_di_sample_radiance(diRes) * debug_params.scale
            : vec3(0.0);
    } else if (debug_params.view == 121u) {
        // RestirDiWeightSum
        float ws = restir_di_weight_sum(restir_di_initial_reservoirs[pixel_index]);
        output_value = vec3(clamp(ws / 64.0, 0.0, 1.0));
    } else if (debug_params.view == 122u) {
        // RestirDiM
        float mVal = float(restir_di_m(restir_di_initial_reservoirs[pixel_index]));
        output_value = vec3(clamp(mVal / 32.0, 0.0, 1.0));
    } else if (debug_params.view == 123u) {
        // RestirDiLightClass
        uint lk = restir_di_light_kind(restir_di_initial_reservoirs[pixel_index]);
        output_value = id_color(lk + 1u);
    } else if (debug_params.view == 23u) {
        output_value = components.first_bounce_throughput;
    } else if (debug_params.view == 24u) {
        output_value = vec3(components.secondary_env_miss);
    } else if (debug_params.view == 25u) {
        output_value = vec3(float(components.bounce_count) / max(float(camera.max_bounces), 1.0));
    } else if (debug_params.view == 26u) {
        output_value = debug_display_tonemap(components.secondary_env_radiance);
    } else if (debug_params.view == 28u) {
        vec2 velocityPixels = restir_unpack_velocity_pixels(packedVelocity);
        vec2 visualVelocity = clamp(velocityPixels / SCREEN_VELOCITY_DEBUG_SCALE, vec2(-1.0), vec2(1.0));
        output_value = vec3(
            visualVelocity * 0.5 + vec2(0.5),
            clamp(length(velocityPixels) / SCREEN_VELOCITY_DEBUG_SCALE, 0.0, 1.0));
    } else if (debug_params.view == 101u) {
        bool skinnedHit = did_hit && ray_tracing_mesh_has_gpu_skinning(components.mesh_id);
        if (skinnedHit) {
            vec2 velocityPixels = restir_unpack_velocity_pixels(packedVelocity);
            vec2 visualVelocity = clamp(velocityPixels / SCREEN_VELOCITY_DEBUG_SCALE, vec2(-1.0), vec2(1.0));
            output_value = vec3(
                visualVelocity * 0.5 + vec2(0.5),
                clamp(length(velocityPixels) / SCREEN_VELOCITY_DEBUG_SCALE, 0.0, 1.0));
        } else {
            output_value = vec3(0.0);
        }
    } else if (debug_params.view == 29u) {
        output_value = debug_display_tonemap(atmosphere_sky_radiance(ray.direction, ATMOSPHERE_RAY_QUALITY_FULL) * max(debug_params.scale, 1.0));
    } else if (debug_params.view == 30u) {
        vec3 transmittance = sample_atmosphere_transmittance_lut(camera.pos.xyz, ray.direction);
        output_value = pow(clamp(transmittance, vec3(0.0), vec3(1.0)), vec3(2.0));
    } else if (debug_params.view == 31u) {
        float viewMu = clamp(normalize(ray.direction).y, -0.15, 1.0);
        vec2 lutUv = vec2(0.8, clamp((viewMu + 0.15) / 1.15, 0.0, 1.0));
        vec4 aerial = texture(sampler3D(atmosphere_aerial_perspective_lut, atmosphere_sampler), vec3(lutUv, 0.5));
        output_value = debug_display_tonemap((aerial.rgb + vec3(1.0 - aerial.a) * 0.15) * max(debug_params.scale, 1.0) * 3.0);
    } else if (debug_params.view == 32u) {
        vec3 multiScatter = sample_multi_scatter_lut_debug(ray.direction);
        output_value = debug_display_tonemap(multiScatter * max(debug_params.scale, 1.0) * 8.0);
    } else if (debug_params.view == 35u) {
        output_value = vec3(clamp(float(restir_age(restir_reservoirs[pixel_index])) / 32.0, 0.0, 1.0));
    } else if (debug_params.view == 36u) {
        output_value = vec3(clamp(restir_reservoirs[pixel_index].sample_value_confidence.a, 0.0, 1.0));
    } else if (debug_params.view == 37u) {
        output_value = vec3(clamp(restir_sample_count(restir_reservoirs[pixel_index]) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 67u) {
        float previousWeight = clamp(restir_previous_weight(restir_reservoirs[pixel_index]), 0.0, 1.0);
        output_value = vec3(previousWeight, 1.0 - previousWeight, clamp(restir_reservoirs[pixel_index].sample_value_confidence.a, 0.0, 1.0));
    } else if (debug_params.view == 68u) {
        RestirGiReservoir reservoir = restir_gi_reservoirs[pixel_index];
        if ((camera.restir_gi_controls.y & 8u) == 0u) {
            output_value = vec3(restir_gi_reservoir_valid(reservoir) ? 1.0 : 0.0);
        } else {
            RestirGiReservoir previousReservoir = previous_restir_gi_reservoirs[pixel_index];
            RestirGiReservoir spatialReservoir = restir_gi_spatial_reservoirs[pixel_index];
            output_value = vec3(
                restir_gi_reservoir_valid(reservoir) ? 1.0 : 0.0,
                restir_gi_reservoir_valid(previousReservoir) ? 1.0 : 0.0,
                restir_gi_reservoir_valid(spatialReservoir) ? 1.0 : 0.0);
        }
    } else if (debug_params.view == 69u) {
        RestirGiReservoir reservoir = restir_gi_reservoirs[pixel_index];
        output_value = vec3(
            restir_gi_age_normalized(reservoir, 32.0),
            clamp(restir_gi_sample_count(reservoir) / 16.0, 0.0, 1.0),
            clamp(restir_gi_target_pdf(reservoir) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 70u || debug_params.view == 71u) {
        RestirGiReservoir reservoir = restir_gi_reservoirs[pixel_index];
        output_value = restir_gi_reservoir_valid(reservoir)
            ? reservoir.radiance_weight_sum.rgb * max(debug_params.scale, 1.0) * 16.0
            : vec3(0.0);
    } else if (debug_params.view == 90u) {
        RestirGiReservoir reservoir = restir_gi_reservoirs[pixel_index];
        output_value = restir_gi_reservoir_valid(reservoir)
            ? restir_gi_normal(reservoir) * 0.5 + vec3(0.5)
            : vec3(0.0);
    } else if (debug_params.view == 91u) {
        RestirGiReservoir reservoir = restir_gi_reservoirs[pixel_index];
        output_value = restir_gi_reservoir_valid(reservoir)
            ? vec3(temporal_normalized_hit_distance(restir_gi_hit_distance(reservoir)))
            : vec3(0.0);
    } else if (debug_params.view == 38u) {
        output_value = components.emissive_continuation > 0.0 ? vec3(0.05, 0.95, 0.35) : vec3(0.0);
    } else if (debug_params.view == 39u) {
        output_value = vec3(clamp(components.sun_mis_weight, 0.0, 1.0));
    } else if (debug_params.view == 40u) {
        output_value = vec3(clamp(log2(max(components.sun_light_pdf, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 41u) {
        output_value = vec3(clamp(log2(max(components.sun_previous_bsdf_pdf, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 42u) {
        output_value = vec3(clamp(log2(max(components.ris_raw_light_pdf, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 43u) {
        output_value = vec3(clamp(log2(max(components.ris_effective_light_pdf, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 44u) {
        output_value = vec3(clamp(log2(max(components.ris_pdf_ratio, 0.0) + 1.0) / 8.0, 0.0, 1.0));
    } else if (debug_params.view == 45u) {
        vec2 s = sample_dimension_2d(ivec2(pixel), camera.temporal_frame_index, 0u, SAMPLE_DIM_DEBUG);
        output_value = vec3(s, sample_dimension_1d(ivec2(pixel), camera.temporal_frame_index, 1u, SAMPLE_DIM_DEBUG + 2u));
    } else if (debug_params.view == 46u) {
        uint seed = sample_dimension_seed(ivec2(pixel), camera.temporal_frame_index, 0u, SAMPLE_DIM_DEBUG);
        output_value = vec3(
            sample_uint_to_unit_float(seed),
            sample_uint_to_unit_float(sample_hash_combine(seed, 17u)),
            sample_uint_to_unit_float(sample_hash_combine(seed, 31u)));
    } else if (debug_params.view == 100u) {
        output_value = vec3(
            clamp(components.caustic_blocked_paths / 4.0, 0.0, 1.0),
            clamp(components.caustic_visible_paths / 4.0, 0.0, 1.0),
            clamp(components.caustic_transmissive_hits / 4.0, 0.0, 1.0));
    } else if (debug_params.view == 47u) {
        output_value = path_data_buffer[pixel_index].direct_diffuse.rgb * debug_params.scale;
    } else if (debug_params.view == 48u) {
        output_value = path_data_buffer[pixel_index].direct_specular.rgb * debug_params.scale;
    } else if (debug_params.view == 49u) {
        output_value = path_data_buffer[pixel_index].indirect_diffuse.rgb * debug_params.scale;
    } else if (debug_params.view == 50u) {
        output_value = path_data_buffer[pixel_index].indirect_specular.rgb * debug_params.scale;
    } else if (debug_params.view == 51u) {
        output_value = path_data_buffer[pixel_index].albedo_roughness_hit_confidence.rgb;
    } else if (debug_params.view == 52u) {
        PathDataRecord pathData = path_data_buffer[pixel_index];
        output_value = vec3(
            clamp(pathData.albedo_roughness_hit_confidence.w, 0.0, 1.0),
            temporal_normalized_hit_distance(pathData.denoiser_hit_distance.x),
            temporal_normalized_hit_distance(pathData.denoiser_hit_distance.y));
    } else if (debug_params.view == 54u) {
        PathDataRecord pathData = path_data_buffer[pixel_index];
        output_value = vec3(
            temporal_normalized_hit_distance(pathData.denoiser_hit_distance.x),
            temporal_normalized_hit_distance(pathData.denoiser_hit_distance.y),
            clamp(pathData.indirect_diffuse.a, 0.0, 1.0));
    } else if (debug_params.view == 165u) {
        output_value = psr_guide_active(components.psr_guide)
            ? vec3(0.05, 1.0, 0.25)
            : (psr_guide_valid(components.psr_guide) ? vec3(0.12) : vec3(0.0));
    } else if (debug_params.view == 166u) {
        float viewZ = psr_guide_valid(components.psr_guide) ? components.psr_guide.distances.y : 0.0;
        output_value = vec3(clamp(log2(max(viewZ, 0.0) + 1.0) / 16.0, 0.0, 1.0));
    } else if (debug_params.view == 167u) {
        vec2 motion = psr_guide_motion_pixels(components.psr_guide);
        output_value = vec3(clamp(abs(motion) / 32.0, vec2(0.0), vec2(1.0)),
            psr_guide_active(components.psr_guide) ? 1.0 : 0.0);
    } else if (debug_params.view == 168u) {
        vec3 normal = psr_guide_normal(components.psr_guide);
        output_value = psr_guide_valid(components.psr_guide)
            ? vec3(normal.xy * 0.5 + 0.5, psr_guide_roughness(components.psr_guide))
            : vec3(0.0);
    } else if (debug_params.view == 169u) {
        float hitDistance = psr_guide_valid(components.psr_guide) ? components.psr_guide.distances.x : 0.0;
        output_value = vec3(temporal_normalized_hit_distance(hitDistance));
    } else if (debug_params.view == 170u) {
        output_value = pixel.x < size.x / 2u
            ? psr_guide_diffuse_albedo(components.psr_guide)
            : psr_guide_specular_f0(components.psr_guide);
    } else if (debug_params.view == 171u) {
        output_value = psr_guide_valid(components.psr_guide)
            ? psr_guide_ray_direction(components.psr_guide) * 0.5 + 0.5
            : vec3(0.0);
    }
    imageStore(output_color, ivec2(pixel), vec4(output_value, 1.0));
#endif
}
