#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly uniform image2D input_color;
layout(set = 0, binding = 1, r32f) readonly uniform image2D input_filled_mask;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D output_color;

layout(push_constant) uniform AdaptiveFillParams {
    uint width;
    uint height;
} params;

bool sampled_pixel(ivec2 coords) {
    vec4 color = imageLoad(input_color, coords);
    float filled = imageLoad(input_filled_mask, coords).r;
    return filled < 0.5 && color.a >= 0.0;
}

vec4 filled_color(ivec2 coords, ivec2 dims) {
    if (sampled_pixel(coords)) {
        vec4 color = imageLoad(input_color, coords);
        return vec4(max(color.rgb, vec3(0.0)), 1.0);
    }

    vec3 sum_value = vec3(0.0);
    float sum_weight = 0.0;
    for (int radius = 1; radius <= 5 && sum_weight <= 1.0e-5; ++radius) {
        for (int y = -radius; y <= radius; ++y) {
            for (int x = -radius; x <= radius; ++x) {
                if (max(abs(x), abs(y)) != radius) {
                    continue;
                }
                ivec2 sample_coords = clamp(coords + ivec2(x, y), ivec2(0), dims - ivec2(1));
                if (!sampled_pixel(sample_coords)) {
                    continue;
                }
                vec4 color = imageLoad(input_color, sample_coords);
                float distance2 = float(x * x + y * y);
                float weight = 1.0 / max(distance2, 1.0);
                sum_value += max(color.rgb, vec3(0.0)) * weight;
                sum_weight += weight;
            }
        }
    }

    if (sum_weight <= 1.0e-5) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }
    return vec4(sum_value / sum_weight, 1.0);
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = ivec2(int(params.width), int(params.height));
    if (dims.x <= 0 || dims.y <= 0 || coords.x >= dims.x || coords.y >= dims.y) {
        return;
    }

    imageStore(output_color, coords, filled_color(coords, dims));
}
