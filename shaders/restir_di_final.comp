#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_ARB_shading_language_packing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require

#define RTV_RESTIR_DI_ENABLE_RAY_QUERY 1
layout(set = 0, binding = 10) uniform accelerationStructureEXT topLevelAS;
#include "restir_di_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Input buffers
layout(set = 0, binding = 0, std430) readonly buffer SpatialReservoirs {
    RestirDiReservoir spatial_reservoirs[];
};
layout(set = 0, binding = 1, std430) readonly buffer ReceiverBuffer {
    RestirDiReceiver receivers[];
};
layout(set = 0, binding = 2, std430) readonly buffer InitialReservoirs {
    RestirDiReservoir initial_reservoirs[];
};

// Output HDR image. The DI pass replaces only the direct-lighting portion.
layout(set = 0, binding = 3, rgba16f) uniform image2D raw_image;

// Output: final reservoir for history copy
layout(set = 0, binding = 4, std430) writeonly buffer FinalReservoirs {
    RestirDiReservoir final_reservoirs[];
};

// Counter buffer
layout(set = 0, binding = 5, std430) buffer Counters {
    uint values[];
} counters;

layout(set = 0, binding = 6, std140) uniform Params {
    uint width;
    uint height;
    uint frameIndex;
    uint enabled;
    uint temporalMaxAge;
    uint spatialRounds;
    uint spatialMaxM;
    uint visibilityPolicy;
    float spatialRadius;
    float normalThreshold;
    float depthThreshold;
    float temporalLuminanceLimitFactor;
    float confidenceDecay;
    float lumClampNeighborAvgFactor;
    float lumClampNeighborMaxFactor;
    float fireflyClamp;
    float productionClampLuminance;
    uint mode;
    uint spatialResultValid;
    uint visibilityRayBudget;
    uint historyValid;
    uint materialVisibilityFlags;
    uint counterEnabled;
    uint rawOutputIsCurrentSample;
    float shadowDistanceBias;
    uint lightVersion;
    uint environmentVersion;
} params;

#define DI_COUNTER_ADD(counter, value) ((params.counterEnabled != 0u) ? atomicAdd(counter, value) : 0u)

struct PathDataRecord {
    vec4 direct_diffuse;
    vec4 direct_specular;
    vec4 indirect_diffuse;
    vec4 indirect_specular;
    vec4 albedo_roughness_hit_confidence;
    vec4 material_specular_albedo;
    vec4 denoiser_hit_distance;
    vec4 diffuse_ray_direction_hit_distance;
    vec4 specular_ray_direction_hit_distance;
    vec4 emissive_residual;
    vec4 restir_gi_fallback_reactive;
};

layout(set = 0, binding = 7, std430) buffer PathDataBuffer {
    PathDataRecord path_data_buffer[];
};

layout(set = 0, binding = 8, std430) buffer AccumulationBuffer {
    vec4 accumulation_buffer[];
};

layout(set = 0, binding = 9, std140) uniform RendererDebug {
    uint view;
    uint flags;
    uint selected_instance;
    float scale;
} debug_params;

layout(set = 0, binding = 11, std430) readonly buffer TemporalReservoirs {
    RestirDiReservoir temporal_reservoirs[];
};

layout(set = 0, binding = 14, std430) buffer VarianceBuffer {
    uint variance_buffer[];
};

layout(set = 0, binding = 24, std430) readonly buffer SelectedSourcePixels {
    uint selected_source_pixels[];
};

layout(set = 0, binding = 25, std430) writeonly buffer FinalSourcePixels {
    uint final_source_pixels[];
};

const uint RESTIR_DI_SOURCE_PIXEL_INVALID = 0xffffffffu;

uint restir_di_pack_source_pixel(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x > 65534 || p.y > 65534) {
        return RESTIR_DI_SOURCE_PIXEL_INVALID;
    }
    return uint(p.x) | (uint(p.y) << 16u);
}

uint restir_di_selected_source_pixel(uint pixelIndex, ivec2 fallbackCoords) {
    uint fallback = restir_di_pack_source_pixel(fallbackCoords);
    uint source = selected_source_pixels[pixelIndex];
    return source == RESTIR_DI_SOURCE_PIXEL_INVALID ? fallback : source;
}

const uint DEBUG_RESTIR_DI_SELECTED_LIGHT = 106u;
const uint DEBUG_RESTIR_DI_TARGET = 107u;
const uint DEBUG_RESTIR_DI_SOURCE_PDF = 108u;
const uint DEBUG_RESTIR_DI_VISIBILITY = 109u;
const uint DEBUG_RESTIR_DI_REJECTION = 110u;
const uint DEBUG_RESTIR_DI_TEMPORAL_ACCEPTANCE = 111u;
const uint DEBUG_RESTIR_DI_SPATIAL_ACCEPTANCE = 112u;
const uint DEBUG_RESTIR_DI_FINAL_CONTRIBUTION = 113u;
const uint DEBUG_RESTIR_DI_RECEIVER_POSITION = 114u;
const uint DEBUG_RESTIR_DI_RECEIVER_NORMAL = 115u;
const uint DEBUG_RESTIR_DI_LIGHT_VERSION = 116u;
const uint DEBUG_RESTIR_DI_INITIAL = 117u;
const uint DEBUG_RESTIR_DI_TEMPORAL = 118u;
const uint DEBUG_RESTIR_DI_SPATIAL = 119u;
const uint DEBUG_RESTIR_DI_FINAL = 120u;
const uint DEBUG_RESTIR_DI_WEIGHT_SUM = 121u;
const uint DEBUG_RESTIR_DI_M = 122u;
const uint DEBUG_RESTIR_DI_LIGHT_CLASS = 123u;
const uint DEBUG_RESTIR_DI_AGE = 124u;
const uint DEBUG_RESTIR_DI_CONFIDENCE = 125u;
const uint DEBUG_RESTIR_DI_REFERENCE_DIFF = 126u;
const uint DEBUG_RESTIR_DI_LIGHT_MAP_STATUS = 158u;
const uint DEBUG_RESTIR_LEGACY_AGE = 35u;
const uint DEBUG_RESTIR_LEGACY_CONFIDENCE = 36u;
const uint DEBUG_RESTIR_LEGACY_M = 37u;

float luminance(vec3 value) {
    return dot(value, vec3(0.2126, 0.7152, 0.0722));
}

vec3 restir_di_reservoir_estimate_at_receiver(RestirDiReservoir reservoir, RestirDiReceiver receiver);

vec3 clamp_luminance_preserve_hue(vec3 value, float maxLum) {
    float valueLum = luminance(max(value, vec3(0.0)));
    if (valueLum <= maxLum || valueLum <= 1.0e-6) {
        return value;
    }
    return value * (maxLum / valueLum);
}

float restir_di_initial_direct_luminance_limit(RestirDiReceiver receiver) {
    float base = max(params.fireflyClamp, 1.0);
    float roughnessScale = mix(0.75, 1.35, clamp(receiver.normal_roughness.w, 0.0, 1.0));
    return max(base, base * 4.0 * roughnessScale);
}

vec3 restir_di_initial_replacement_estimate(RestirDiReservoir reservoir, RestirDiReceiver receiver) {
    vec3 estimate = restir_di_reservoir_estimate_at_receiver(reservoir, receiver);
    return clamp_luminance_preserve_hue(
        estimate,
        restir_di_initial_direct_luminance_limit(receiver));
}

uint pack_variance(float value) {
    return packUnorm2x16(vec2(clamp(value / 64.0, 0.0, 1.0), 0.0));
}

RestirDiReservoir restir_di_empty_with_m(RestirDiReservoir source) {
    RestirDiReservoir empty = restir_di_empty_reservoir();
    restir_di_set_m(empty, restir_di_m(source));
    return empty;
}

void restir_di_atomic_add_u64(uint lowIndex, uint highIndex, uint value) {
    uint previous = DI_COUNTER_ADD(counters.values[lowIndex], value);
    if (previous > 0xffffffffu - value) {
        DI_COUNTER_ADD(counters.values[highIndex], 1u);
    }
}

bool restir_di_relative_mismatch(float storedValue, float evaluatedValue, float tolerance) {
    if (isnan(storedValue) || isinf(storedValue) ||
        isnan(evaluatedValue) || isinf(evaluatedValue)) {
        return true;
    }
    float scale = max(max(abs(storedValue), abs(evaluatedValue)), 1.0e-3);
    return abs(storedValue - evaluatedValue) / scale > tolerance;
}

vec3 restir_di_id_color(uint id) {
    uint h = id * 747796405u + 2891336453u;
    h = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
    h = (h >> 22u) ^ h;
    return vec3(
        float((h >> 0u) & 255u),
        float((h >> 8u) & 255u),
        float((h >> 16u) & 255u)) / 255.0;
}

vec3 restir_di_visibility_color(uint visibility) {
    if (visibility == RESTIR_DI_VISIBILITY_VISIBLE) return vec3(0.0, 1.0, 0.0);
    if (visibility == RESTIR_DI_VISIBILITY_OCCLUDED) return vec3(1.0, 0.0, 0.0);
    if (visibility == RESTIR_DI_VISIBILITY_INVALID) return vec3(1.0, 0.0, 1.0);
    return vec3(0.0, 0.2, 1.0);
}

vec3 restir_di_light_map_status_color(RestirDiReservoir reservoir) {
    RestirDiLightRecord light;
    uint lightIndex;
    uint mapStatus;
    bool resolved = restir_di_resolve_light_with_status(
        reservoir,
        light,
        lightIndex,
        mapStatus,
        params.lightVersion,
        params.environmentVersion);
    if (mapStatus == RESTIR_DI_LIGHT_MAP_CACHED) return vec3(0.0, 1.0, 0.0);
    if (mapStatus == RESTIR_DI_LIGHT_MAP_REMAPPED) return vec3(0.1, 0.45, 1.0);
    if (mapStatus == RESTIR_DI_LIGHT_MAP_CHANGED) return vec3(1.0, 0.75, 0.0);
    if (mapStatus == RESTIR_DI_LIGHT_MAP_UNMAPPED) return vec3(1.0, 0.0, 0.0);
    if (mapStatus == RESTIR_DI_LIGHT_MAP_INFINITE) return resolved ? vec3(0.0, 1.0, 1.0) : vec3(1.0, 0.0, 1.0);
    return vec3(0.25);
}

vec3 restir_di_reservoir_estimate_at_receiver(RestirDiReservoir reservoir, RestirDiReceiver receiver) {
    if (!restir_di_reservoir_valid(reservoir)) return vec3(0.0);
    RestirDiLightRecord light;
    uint lightIndex;
    if (!restir_di_resolve_light(
            reservoir,
            light,
            lightIndex,
            params.lightVersion,
            params.environmentVersion)) return vec3(0.0);
    vec3 lightNormal = restir_di_light_normal(reservoir);
    float pdf = restir_di_pdf_at_receiver(
        lightIndex, light, receiver.worldPosition_depth.xyz,
        reservoir.samplePosition_distance.xyz, lightNormal);
    vec3 direction;
    float distanceToLight;
    vec3 integrand = restir_di_evaluate_integrand(
        reservoir, receiver, light, pdf, direction, distanceToLight, lightNormal);
    return restir_di_final_estimate(
        integrand,
        restir_di_weight_sum(reservoir),
        float(max(restir_di_m(reservoir), 1u)),
        restir_di_target(reservoir));
}

vec3 restir_di_reservoir_debug(RestirDiReservoir reservoir, uint view) {
    if (!restir_di_reservoir_valid(reservoir)) {
        return vec3(0.0);
    }
    if (view == DEBUG_RESTIR_DI_SELECTED_LIGHT) {
        return restir_di_id_color(restir_di_light_id(reservoir) + 1u);
    }
    if (view == DEBUG_RESTIR_DI_TARGET) {
        return vec3(clamp(restir_di_target(reservoir) / 16.0, 0.0, 1.0));
    }
    if (view == DEBUG_RESTIR_DI_SOURCE_PDF) {
        return vec3(clamp(log2(max(restir_di_source_pdf(reservoir), 1.0e-6) + 1.0) / 16.0, 0.0, 1.0));
    }
    if (view == DEBUG_RESTIR_DI_VISIBILITY) {
        return restir_di_visibility_color(restir_di_visibility(reservoir));
    }
    if (view == DEBUG_RESTIR_DI_REJECTION) {
        uint flags = restir_di_rejection_flags(reservoir);
        return vec3(float((flags >> 0u) & 1u), float((flags >> 1u) & 1u), float((flags >> 2u) & 1u));
    }
    if (view == DEBUG_RESTIR_DI_LIGHT_VERSION) {
        return vec3(float(restir_di_light_version(reservoir) & 255u) / 255.0);
    }
    if (view == DEBUG_RESTIR_DI_LIGHT_MAP_STATUS) {
        return restir_di_light_map_status_color(reservoir);
    }
    if (view == DEBUG_RESTIR_DI_WEIGHT_SUM) {
        return vec3(clamp(restir_di_weight_sum(reservoir) / 64.0, 0.0, 1.0));
    }
    if (view == DEBUG_RESTIR_DI_M || view == DEBUG_RESTIR_LEGACY_M) {
        float maxM = max(float(params.spatialMaxM), 1.0);
        return vec3(clamp(float(restir_di_m(reservoir)) / maxM, 0.0, 1.0));
    }
    if (view == DEBUG_RESTIR_DI_LIGHT_CLASS) {
        return restir_di_id_color(restir_di_light_kind(reservoir) + 1u);
    }
    if (view == DEBUG_RESTIR_DI_AGE || view == DEBUG_RESTIR_LEGACY_AGE) {
        float maxAge = max(float(params.temporalMaxAge), 1.0);
        return vec3(clamp(float(restir_di_age(reservoir)) / maxAge, 0.0, 1.0));
    }
    if (view == DEBUG_RESTIR_DI_CONFIDENCE || view == DEBUG_RESTIR_LEGACY_CONFIDENCE) {
        float confidence = restir_di_confidence(reservoir);
        return vec3(1.0 - confidence, confidence, 0.0);
    }
    return restir_di_sample_radiance(reservoir) * debug_params.scale;
}

bool restir_di_write_debug(
    ivec2 coords,
    RestirDiReceiver receiver,
    RestirDiReservoir initial,
    RestirDiReservoir temporal,
    RestirDiReservoir spatial,
    RestirDiReservoir finalReservoir) {
    uint view = debug_params.view;
    vec3 color;
    if (view == DEBUG_RESTIR_DI_RECEIVER_POSITION) {
        color = fract(receiver.worldPosition_depth.xyz * 0.25);
    } else if (view == DEBUG_RESTIR_DI_RECEIVER_NORMAL) {
        color = normalize(receiver.normal_roughness.xyz) * 0.5 + vec3(0.5);
    } else if (view == DEBUG_RESTIR_DI_TEMPORAL_ACCEPTANCE) {
        float previousWeight = restir_di_previous_weight(temporal);
        color = vec3(previousWeight, 1.0 - previousWeight, 0.0);
    } else if (view == DEBUG_RESTIR_DI_SPATIAL_ACCEPTANCE) {
        bool selectedNeighbor = restir_di_reservoir_valid(spatial) &&
            restir_di_reservoir_valid(temporal) &&
            (restir_di_light_id(spatial) != restir_di_light_id(temporal) ||
             restir_di_m(spatial) > restir_di_m(temporal));
        color = selectedNeighbor ? vec3(0.1, 0.9, 1.0) : vec3(1.0, 0.75, 0.1);
    } else if (view == DEBUG_RESTIR_DI_REFERENCE_DIFF) {
        vec3 initialEstimate = restir_di_reservoir_estimate_at_receiver(initial, receiver);
        vec3 finalEstimate = restir_di_reservoir_estimate_at_receiver(finalReservoir, receiver);
        color = abs(finalEstimate - initialEstimate) * debug_params.scale;
    } else if (view == DEBUG_RESTIR_DI_FINAL || view == DEBUG_RESTIR_DI_FINAL_CONTRIBUTION) {
        color = restir_di_reservoir_estimate_at_receiver(finalReservoir, receiver) * debug_params.scale;
    } else if (view == DEBUG_RESTIR_DI_INITIAL) {
        color = restir_di_reservoir_debug(initial, view);
    } else if (view == DEBUG_RESTIR_DI_TEMPORAL) {
        color = restir_di_reservoir_debug(temporal, view);
    } else if (view == DEBUG_RESTIR_DI_SPATIAL) {
        color = restir_di_reservoir_debug(spatial, view);
    } else if (view == DEBUG_RESTIR_DI_FINAL ||
               view == DEBUG_RESTIR_DI_FINAL_CONTRIBUTION ||
               view == DEBUG_RESTIR_DI_SELECTED_LIGHT ||
               view == DEBUG_RESTIR_DI_TARGET ||
               view == DEBUG_RESTIR_DI_SOURCE_PDF ||
               view == DEBUG_RESTIR_DI_VISIBILITY ||
               view == DEBUG_RESTIR_DI_REJECTION ||
               view == DEBUG_RESTIR_DI_LIGHT_VERSION ||
               view == DEBUG_RESTIR_DI_LIGHT_MAP_STATUS ||
               view == DEBUG_RESTIR_DI_WEIGHT_SUM ||
               view == DEBUG_RESTIR_DI_M ||
               view == DEBUG_RESTIR_DI_LIGHT_CLASS ||
               view == DEBUG_RESTIR_DI_AGE ||
               view == DEBUG_RESTIR_DI_CONFIDENCE ||
               view == DEBUG_RESTIR_LEGACY_AGE ||
               view == DEBUG_RESTIR_LEGACY_CONFIDENCE ||
               view == DEBUG_RESTIR_LEGACY_M) {
        color = restir_di_reservoir_debug(finalReservoir, view);
    } else {
        return false;
    }
    imageStore(raw_image, coords, vec4(max(color, vec3(0.0)), 1.0));
    return true;
}

void replace_direct_lighting(
    ivec2 coords,
    uint pixelIndex,
    vec3 initialContribution,
    vec3 finalContribution,
    RestirDiReservoir selected,
    RestirDiReceiver receiver,
    bool useStoredInitialDirect) {
    if (debug_params.view != 0u) {
        return;
    }

    PathDataRecord path = path_data_buffer[pixelIndex];
    vec4 directDiffuse = path.direct_diffuse;
    vec4 directSpecular = path.direct_specular;
    vec4 indirectDiffuse = path.indirect_diffuse;
    vec4 indirectSpecular = path.indirect_specular;
    vec4 emissiveResidual = path.emissive_residual;
    vec3 oldDiffuse = max(directDiffuse.rgb, vec3(0.0));
    vec3 oldSpecular = max(directSpecular.rgb, vec3(0.0));
    vec3 oldDirect = oldDiffuse + oldSpecular;
    if (useStoredInitialDirect) {
        finalContribution = oldDirect;
        initialContribution = oldDirect;
    } else {
        // Reused temporal/spatial samples are valuable when the current
        // frame missed a light, but at hard visibility boundaries a shifted
        // sample can be underweighted or classified differently than the
        // raygen NEE sample that is already in the image. Do not let reuse
        // carve persistent black gaps by subtracting a strong current-frame
        // direct-light sample down to near zero; falling back here is just the
        // unbiased current NEE sample for this pixel.
        float oldDirectLumForReuse = luminance(oldDirect);
        float finalLumForReuse = luminance(max(finalContribution, vec3(0.0)));
        if (oldDirectLumForReuse > 1.0e-4 &&
            finalLumForReuse < oldDirectLumForReuse * 0.35) {
            finalContribution = oldDirect;
            initialContribution = oldDirect;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_FALLBACK], 1u);
        }
    }
    // The image/accumulation buffers already contain the raygen direct signal
    // stored in path_data_buffer. The reservoir's initial estimate is
    // re-evaluated here only to identify the ReSTIR-owned part of that signal,
    // but it can differ from the stored value after raygen firefly/direct-light
    // clamping or material-path bookkeeping. If we subtract the re-evaluated
    // initial estimate verbatim, Production ReSTIR DI can remove more light
    // than raygen actually wrote, producing dark clipped regions around very
    // bright emitters (Veach Ajar's doorway is the sharp repro). Clamp the
    // replacement baseline to the direct signal that is actually present.
    vec3 replacementBaseline = max(initialContribution, vec3(0.0));
    float oldDirectLum = luminance(oldDirect);
    float baselineLum = luminance(replacementBaseline);
    if (baselineLum > oldDirectLum && baselineLum > 1.0e-6) {
        replacementBaseline *= oldDirectLum / baselineLum;
    }
    vec3 directDelta = finalContribution - replacementBaseline;
    vec3 newDirect = max(oldDirect + directDelta, vec3(0.0));

    vec4 accumulated = accumulation_buffer[pixelIndex];
    float accumulationSamples = max(accumulated.a, 1.0);
    accumulation_buffer[pixelIndex] = vec4(max(accumulated.rgb + directDelta, vec3(0.0)), accumulated.a);

    vec3 base = imageLoad(raw_image, coords).rgb;
    float rawDeltaScale = params.rawOutputIsCurrentSample != 0u ? 1.0 : 1.0 / accumulationSamples;
    vec3 replaced = max(base + directDelta * rawDeltaScale, vec3(0.0));
    imageStore(raw_image, coords, vec4(replaced, 1.0));

    float diffuseLum = luminance(oldDiffuse);
    float specularLum = luminance(oldSpecular);
    float totalLum = diffuseLum + specularLum;
    vec3 receiverDiffuse = restir_di_receiver_base_color(receiver) *
        (1.0 - restir_di_receiver_metallic(receiver));
    vec3 receiverSpecular = restir_di_receiver_specular_color(receiver);
    float materialTotal = luminance(receiverDiffuse) + luminance(receiverSpecular);
    float materialSpecularWeight = materialTotal > 1.0e-6
        ? luminance(receiverSpecular) / materialTotal
        : 0.0;
    float specularWeight = totalLum > 1.0e-6
        ? clamp(specularLum / totalLum, 0.0, 1.0)
        : clamp(materialSpecularWeight, 0.0, 1.0);
    directDiffuse.rgb = newDirect * (1.0 - specularWeight);
    directSpecular.rgb = newDirect * specularWeight;

    RestirDiLightRecord guideLight;
    uint guideLightIndex;
    if (restir_di_reservoir_valid(selected) &&
        restir_di_resolve_light(
            selected,
            guideLight,
            guideLightIndex,
            params.lightVersion,
            params.environmentVersion)) {
        uint kind = restir_di_light_kind(selected);
        vec3 guideDirection;
        float guideDistance;
        if (kind == RESTIR_DI_LIGHT_DIRECTIONAL) {
            guideDirection = normalize(guideLight.data1.xyz);
            guideDistance = 10000.0;
        } else if (restir_di_light_kind_infinite(kind)) {
            guideDirection = normalize(selected.samplePosition_distance.xyz);
            guideDistance = 10000.0;
        } else {
            vec3 toLight = selected.samplePosition_distance.xyz - receiver.worldPosition_depth.xyz;
            guideDistance = length(toLight);
            guideDirection = toLight / max(guideDistance, 1.0e-6);
        }
        float indirectDiffuseLum = luminance(max(indirectDiffuse.rgb, vec3(0.0)));
        float indirectSpecularLum = luminance(max(indirectSpecular.rgb, vec3(0.0)));
        if (luminance(directDiffuse.rgb) >= indirectDiffuseLum) {
            path.diffuse_ray_direction_hit_distance = vec4(guideDirection, guideDistance);
            path.denoiser_hit_distance.x = guideDistance;
        }
        if (luminance(directSpecular.rgb) >= indirectSpecularLum) {
            path.specular_ray_direction_hit_distance = vec4(guideDirection, guideDistance);
            path.denoiser_hit_distance.y = guideDistance;
        }
    }
    vec3 currentSignal = max(directDiffuse.rgb, vec3(0.0)) +
        max(directSpecular.rgb, vec3(0.0)) +
        max(indirectDiffuse.rgb, vec3(0.0)) +
        max(indirectSpecular.rgb, vec3(0.0)) +
        max(emissiveResidual.rgb, vec3(0.0));
    vec3 accumulatedAverage = max(accumulation_buffer[pixelIndex].rgb, vec3(0.0)) / accumulationSamples;
    variance_buffer[pixelIndex] = pack_variance(abs(luminance(currentSignal) - luminance(accumulatedAverage)));
    path.direct_diffuse = directDiffuse;
    path.direct_specular = directSpecular;
    path_data_buffer[pixelIndex] = path;
}

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    if (coords.x >= int(params.width) || coords.y >= int(params.height)) {
        return;
    }

    uint pixelIndex = uint(coords.y) * params.width + uint(coords.x);
    final_source_pixels[pixelIndex] = RESTIR_DI_SOURCE_PIXEL_INVALID;
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_PIXELS], 1u);

    // Load receiver
    RestirDiReceiver receiver = receivers[pixelIndex];
    uint surfaceFlags = restir_di_receiver_surface_flags(receiver);
    bool unsupportedSurface = (surfaceFlags & (RESTIR_DI_SURFACE_SKY |
                                               RESTIR_DI_SURFACE_INVALID |
                                               RESTIR_DI_SURFACE_DELTA |
                                               RESTIR_DI_SURFACE_ALPHA |
                                               RESTIR_DI_SURFACE_UNLIT |
                                               RESTIR_DI_SURFACE_UNSUPPORTED)) != 0u;
    if (unsupportedSurface && debug_params.view == 0u) {
        final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
        return;
    }

    // Load spatial reservoir
    RestirDiReservoir selected = spatial_reservoirs[pixelIndex];
    RestirDiReservoir spatialDebug = selected;
    RestirDiReservoir temporalDebug = temporal_reservoirs[pixelIndex];
    RestirDiReservoir initial = initial_reservoirs[pixelIndex];
    uint rejectionFlags = restir_di_rejection_flags(selected) |
        restir_di_rejection_flags(temporalDebug);
    bool usedFallback = false;
    // Hybrid compare keeps classic NEE on the left and applies the new DI
    // estimator on the right while still producing valid per-pixel history.
    if (params.mode == 4u && coords.x < int(params.width / 2u)) {
        final_reservoirs[pixelIndex] = initial;
        final_source_pixels[pixelIndex] = restir_di_pack_source_pixel(coords);
        restir_di_write_debug(coords, receiver, initial, temporalDebug, spatialDebug, initial);
        return;
    }

    // Determine which reservoir to use for final shading
    if (!restir_di_reservoir_valid(selected) || params.enabled == 0u) {
        // Fall back to initial reservoir
        if (restir_di_reservoir_valid(initial)) {
            selected = initial;
            usedFallback = true;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_FALLBACK], 1u);
        }
    }

    if (!restir_di_reservoir_valid(selected)) {
        // No valid reservoir: keep the existing path-traced lighting intact.
        final_reservoirs[pixelIndex] = restir_di_empty_with_m(selected);
        restir_di_write_debug(
            coords,
            receiver,
            initial,
            temporalDebug,
            spatialDebug,
            restir_di_empty_reservoir());
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
        return;
    }

    RestirDiLightRecord selectedLight;
    uint resolvedLightIndex;
    if (!restir_di_resolve_light(
            selected,
            selectedLight,
            resolvedLightIndex,
            params.lightVersion,
            params.environmentVersion)) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_LIGHT_REJECTED], 1u);
        if (!usedFallback && restir_di_reservoir_valid(initial) &&
            restir_di_resolve_light(
                initial,
                selectedLight,
                resolvedLightIndex,
                params.lightVersion,
                params.environmentVersion)) {
            selected = initial;
            usedFallback = true;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_FALLBACK], 1u);
        } else {
            final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
            restir_di_write_debug(
                coords,
                receiver,
                initial,
                temporalDebug,
                spatialDebug,
                restir_di_empty_reservoir());
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
            return;
        }
    }
    uint selectedKind = restir_di_light_kind(selected);
    selected.sampleMetadata.z = (resolvedLightIndex << 8u) | (selectedKind & 0xffu);

    // Check surface validity
    if (unsupportedSurface) {
        final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
        restir_di_write_debug(
            coords,
            receiver,
            initial,
            temporalDebug,
            spatialDebug,
            restir_di_empty_reservoir());
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
        return;
    }

    uint visibility = restir_di_visibility(selected);
    if ((visibility == RESTIR_DI_VISIBILITY_OCCLUDED ||
         (visibility == RESTIR_DI_VISIBILITY_UNKNOWN && params.visibilityRayBudget == 0u)) &&
        !usedFallback) {
        // Occluded reused sample: fall back to initial candidate
        if (restir_di_reservoir_valid(initial)) {
            selected = initial;
            usedFallback = true;
            visibility = restir_di_visibility(selected);
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_FALLBACK], 1u);
        } else {
            final_reservoirs[pixelIndex] = restir_di_empty_with_m(selected);
            restir_di_write_debug(
                coords,
                receiver,
                initial,
                temporalDebug,
                spatialDebug,
                restir_di_empty_reservoir());
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
            return;
        }
    }

    if (usedFallback && !restir_di_resolve_light(
            selected,
            selectedLight,
            resolvedLightIndex,
            params.lightVersion,
            params.environmentVersion)) {
        final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
        restir_di_write_debug(
            coords,
            receiver,
            initial,
            temporalDebug,
            spatialDebug,
            restir_di_empty_reservoir());
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
        return;
    }

    // Re-evaluate sample at current receiver
    vec3 receiverPos = receiver.worldPosition_depth.xyz;
    vec3 receiverNormal = normalize(receiver.normal_roughness.xyz);
    vec3 samplePos = selected.samplePosition_distance.xyz;
    vec3 sampleDir;
    float distToLight;
    vec3 selectedLightNormal = restir_di_light_normal(selected);
    float selectedPdf = restir_di_pdf_at_receiver(
        resolvedLightIndex, selectedLight, receiverPos, samplePos, selectedLightNormal);
#if !RTV_RESTIR_DI_VALIDATION_FULL
    selectedPdf = clamp(selectedPdf, 1.0e-6, 65504.0);
#endif
    vec3 radiance = restir_di_evaluate_integrand(
        selected, receiver, selectedLight, selectedPdf,
        sampleDir, distToLight, selectedLightNormal);
    float evaluatedTarget = restir_di_target_function(radiance);
#if !RTV_RESTIR_DI_VALIDATION_FULL
    evaluatedTarget = clamp(evaluatedTarget, 1.0e-6, 65504.0);
#endif

    // Final history must be expressed at the current receiver. Temporal and
    // spatial reuse may carry a selected sample across pixels, so canonicalize
    // the selected reservoir here before validating/exporting it.
    restir_di_set_direction(selected, sampleDir);
    selected.samplePosition_distance.w = distToLight;
    restir_di_set_source_pdf(selected, selectedPdf);
    restir_di_set_target(selected, evaluatedTarget);
    restir_di_set_sample_radiance(selected, radiance);
    restir_di_set_light_normal(selected, selectedLightNormal);

    const float packedReservoirParityTolerance = 5.0e-3;
    const float fullReservoirParityTolerance = 1.0e-3;
#if RTV_RESTIR_DI_VALIDATION_FULL
    float reservoirParityTolerance = fullReservoirParityTolerance;
#else
    float reservoirParityTolerance = packedReservoirParityTolerance;
#endif
    if (restir_di_relative_mismatch(restir_di_source_pdf(selected), selectedPdf, reservoirParityTolerance) ||
        restir_di_relative_mismatch(restir_di_target(selected), evaluatedTarget, reservoirParityTolerance)) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_CONTRACT_INVALID], 1u);
    }

    // Reference mode always validates visibility. Production validates any
    // shifted sample whose visibility is no longer current at this receiver.
    if (params.visibilityPolicy == 0u &&
        visibility == RESTIR_DI_VISIBILITY_UNKNOWN &&
        restir_di_light_kind_infinite(selectedKind)) {
        visibility = RESTIR_DI_VISIBILITY_VISIBLE;
    }
    bool needsVisibility = params.visibilityPolicy == 1u ||
        visibility == RESTIR_DI_VISIBILITY_UNKNOWN;
    float finiteLightDistanceBias = max(params.shadowDistanceBias, RESTIR_DI_VISIBILITY_EPSILON * 2.0);
    if (needsVisibility && params.visibilityRayBudget > 0u &&
        distToLight > finiteLightDistanceBias) {
        float tmax = distToLight - finiteLightDistanceBias;
        vec3 shadowOrigin = receiverPos +
            sampleDir * RESTIR_DI_VISIBILITY_EPSILON +
            receiverNormal * RESTIR_DI_VISIBILITY_EPSILON;
        visibility = restir_di_ray_query_visible(
            shadowOrigin,
            sampleDir,
            tmax,
            params.materialVisibilityFlags);
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_VISIBILITY_CHECKED], 1u);
    } else if (needsVisibility && params.visibilityRayBudget > 0u) {
        visibility = RESTIR_DI_VISIBILITY_VISIBLE;
    }

    float weightSum = restir_di_weight_sum(selected);
    float m = float(max(restir_di_m(selected), 1u));
    float target = restir_di_target(selected);
    vec3 estimate = restir_di_final_estimate(radiance, weightSum, m, target);

    // Visibility
    if (visibility == RESTIR_DI_VISIBILITY_UNKNOWN || visibility == RESTIR_DI_VISIBILITY_INVALID) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_UNKNOWN_VISIBILITY], 1u);
        final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
        restir_di_write_debug(
            coords,
            receiver,
            initial,
            temporalDebug,
            spatialDebug,
            restir_di_empty_reservoir());
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
        return;
    } else if (visibility == RESTIR_DI_VISIBILITY_OCCLUDED) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_OCCLUDED], 1u);
        rejectionFlags |= RESTIR_DI_REJECT_VISIBILITY;
        if (!usedFallback && restir_di_reservoir_valid(initial)) {
            vec3 fallbackEstimate = restir_di_initial_replacement_estimate(initial, receiver);
            if (!any(isnan(fallbackEstimate)) && !any(isinf(fallbackEstimate))) {
                selected = initial;
                estimate = max(fallbackEstimate, vec3(0.0));
                usedFallback = true;
                DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_FALLBACK], 1u);
            } else {
                final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
                DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
                return;
            }
        } else {
            final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
            return;
        }
    } else {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_VISIBLE], 1u);
    }

    // Production clamps
    float estimateHistoryScale = 1.0;
    if (params.temporalLuminanceLimitFactor > 0.0 && params.fireflyClamp > 0.0) {
        float lum = dot(estimate, vec3(0.2126, 0.7152, 0.0722));
        if (lum > params.fireflyClamp) {
            float clampScale = params.fireflyClamp / max(lum, 1.0e-8);
            estimate *= clampScale;
            estimateHistoryScale *= clampScale;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_CLAMPED], 1u);
            rejectionFlags |= RESTIR_DI_REJECT_CLAMPED;
        }
    }

    if (params.temporalLuminanceLimitFactor > 0.0 && params.productionClampLuminance > 0.0) {
        float lum = dot(estimate, vec3(0.2126, 0.7152, 0.0722));
        if (lum > params.productionClampLuminance) {
            float clampScale = params.productionClampLuminance / max(lum, 1.0e-8);
            estimate *= clampScale;
            estimateHistoryScale *= clampScale;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_CLAMPED], 1u);
            rejectionFlags |= RESTIR_DI_REJECT_CLAMPED;
        }
    }

    vec3 initialContribution = restir_di_initial_replacement_estimate(initial, receiver);
    bool initialFinite = !any(isnan(initialContribution)) && !any(isinf(initialContribution));
    vec3 finalContribution = max(estimate, vec3(0.0));
    if (any(isnan(finalContribution)) || any(isinf(finalContribution))) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_NON_FINITE], 1u);
        if (restir_di_reservoir_valid(initial) && initialFinite) {
            selected = initial;
            finalContribution = max(initialContribution, vec3(0.0));
            usedFallback = true;
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_FALLBACK], 1u);
        } else {
            final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
            DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
            return;
        }
    }
    if (!initialFinite) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_NON_FINITE], 1u);
        final_reservoirs[pixelIndex] = restir_di_empty_reservoir();
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_INVALID], 1u);
        return;
    }
    float currentInitialDistanceTolerance = max(
        1.0e-4,
        max(abs(selected.samplePosition_distance.w), abs(initial.samplePosition_distance.w)) * 1.0e-5);
    bool selectedIsCurrentInitialSample =
        restir_di_reservoir_valid(initial) &&
        all(equal(selected.sampleMetadata.xyz, initial.sampleMetadata.xyz)) &&
        distance(selected.samplePosition_distance.xyz, initial.samplePosition_distance.xyz) <=
            currentInitialDistanceTolerance &&
        abs(selected.samplePosition_distance.w - initial.samplePosition_distance.w) <=
            currentInitialDistanceTolerance;
    replace_direct_lighting(
        coords,
        pixelIndex,
        initialContribution,
        finalContribution,
        selected,
        receiver,
        selectedIsCurrentInitialSample);
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_ESTIMATE], 1u);
    DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_FINAL_VALID], 1u);

    // Prepare final reservoir for history copy
    // Preserve sample identity, update age, set as valid
    RestirDiReservoir historyReservoir = selected;
    restir_di_set_age(historyReservoir, restir_di_age(selected));
    restir_di_set_valid(historyReservoir, restir_di_reservoir_valid(historyReservoir));
    restir_di_set_confidence(historyReservoir, restir_di_confidence(selected));
    restir_di_set_rejection_flags(historyReservoir, rejectionFlags);
    if (estimateHistoryScale < 0.999) {
        restir_di_set_weight_sum(
            historyReservoir,
            restir_di_weight_sum(historyReservoir) * clamp(estimateHistoryScale, 0.0, 1.0));
    }

    const float aggregateScale = 256.0;
    restir_di_atomic_add_u64(
        RESTIR_DI_COUNTER_SUM_M_LOW, RESTIR_DI_COUNTER_SUM_M_HIGH,
        restir_di_m(historyReservoir));
    restir_di_atomic_add_u64(
        RESTIR_DI_COUNTER_SUM_AGE_LOW, RESTIR_DI_COUNTER_SUM_AGE_HIGH,
        restir_di_age(historyReservoir));
    restir_di_atomic_add_u64(
        RESTIR_DI_COUNTER_SUM_WEIGHT_LOW, RESTIR_DI_COUNTER_SUM_WEIGHT_HIGH,
        uint(round(clamp(restir_di_weight_sum(historyReservoir), 0.0, 65535.0) * aggregateScale)));
    restir_di_atomic_add_u64(
        RESTIR_DI_COUNTER_SUM_LUMINANCE_LOW, RESTIR_DI_COUNTER_SUM_LUMINANCE_HIGH,
        uint(round(clamp(luminance(finalContribution), 0.0, 65535.0) * aggregateScale)));

    // ValidationFull preserves the finalized contribution for inspection.
#if RTV_RESTIR_DI_VALIDATION_FULL
    historyReservoir.contribution_confidence.rgb = finalContribution;
#endif

    if (restir_di_valid_bit_contract_invalid(historyReservoir)) {
        DI_COUNTER_ADD(counters.values[RESTIR_DI_COUNTER_CONTRACT_INVALID], 1u);
    }
    final_reservoirs[pixelIndex] = historyReservoir;
    final_source_pixels[pixelIndex] = (usedFallback || selectedIsCurrentInitialSample)
        ? restir_di_pack_source_pixel(coords)
        : restir_di_selected_source_pixel(pixelIndex, coords);
    restir_di_write_debug(
        coords,
        receiver,
        initial,
        temporalDebug,
        spatialDebug,
        historyReservoir);
}
