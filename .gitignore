# Runtime-only repository allowlist. Everything not explicitly allowed stays local.
/*

!/.gitignore
!/CMakeLists.txt
!/README.md
!/run_rtvulkan.bat
!/run_rtvulkan_debug.bat

!/include/
!/include/**
!/src/
!/src/**
!/shaders/
!/shaders/**

!/tools/
/tools/*
!/tools/bvh_benchmark.cpp

!/third_party/
/third_party/*

!/third_party/tinyexr/
/third_party/tinyexr/*
!/third_party/tinyexr/tinyexr.h
!/third_party/tinyexr/deps/
/third_party/tinyexr/deps/*
!/third_party/tinyexr/deps/miniz/
/third_party/tinyexr/deps/miniz/*
!/third_party/tinyexr/deps/miniz/miniz.c
!/third_party/tinyexr/deps/miniz/miniz.h

!/third_party/tabler-icons/
/third_party/tabler-icons/*
!/third_party/tabler-icons/LICENSE
!/third_party/tabler-icons/tabler-icons.ttf

!/third_party/STBN/
/third_party/STBN/*
!/third_party/STBN/License.txt
!/third_party/STBN/Assets/
/third_party/STBN/Assets/*
!/third_party/STBN/Assets/STBN/
/third_party/STBN/Assets/STBN/*
!/third_party/STBN/Assets/STBN/stbn_scalar_2Dx1Dx1D_128x128x64x1_*.png

# Generated files inside allowed source directories.
*.spv
*.spv.tmp
*.spv.log
*.obj
*.o
*.lib
*.dll
*.exe
*.pdb
*.cache.bin
*.log
*.tmp
*.temp
