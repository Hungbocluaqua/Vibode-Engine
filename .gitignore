# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# =============================================================================
# Local AI/tool state
# =============================================================================
/.claude/
# Local code index used by OpenCode/Codex. Keep locally, do not upload.
/.codegraph/
/.opencode/node_modules/
/.opencode/package-lock.json
/.opencode/package.json
/.opencode/.gitignore

# Keep intentional OpenCode config files tracked, such as:
# /.opencode/dcp.jsonc
# /opencode.json

# =============================================================================
# Node dependencies
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================================
# Local documentation archives / research PDFs
# =============================================================================
# Keep markdown docs/plans in docs/, but do not upload large paper archives.
/docs/Research papers/
/docs/Research papers*/
/docs/**/*.pdf

# =============================================================================
# Large local scene/assets - not committed to GitHub
# =============================================================================
/Sponza/
/main_sponza/
/san-miguel/
/Bistro_v5_2/
/JungleRuins/
/niagara_bistro-master/
/assets/
/Assets/
/content/
/Content/
/game_assets/
/GameAssets/
/asset_cache/
/AssetCache/

# Heavy imported/source asset formats
*.fbx
*.blend
*.max
*.usd
*.usda
*.usdc
*.usdz
*.abc

# Heavy texture/environment formats
*.hdr
*.exr
*.tga
*.tif
*.tiff
*.dds
*.ktx
*.ktx2

# Keep small committed validation/test/project content visible to Git.
!scenes/validation/**
!tests/**/*
!Samples/**/*
!Projects/**/*

# But still ignore generated/cooked caches inside those folders.
scenes/validation/**/*.cache.bin
tests/**/*.cache.bin
Samples/**/*.cache.bin
Projects/**/*.cache.bin

# =============================================================================
# Third-party generated/vendor build subfolders
# =============================================================================
third_party/**/build/
third_party/**/bin/
third_party/**/lib/
third_party/**/*.pdb
third_party/**/*.ilk
third_party/**/*.exe
third_party/**/*.dll
third_party/**/*.obj
third_party/**/*.o

# =============================================================================
# Python/tooling cache
# =============================================================================
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
